"rules_dotnet"

module(
    name = "rules_dotnet",
    bazel_compatibility = [">=8.0.0"],
)

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(host = True)
dotnet.toolchain(
    name = "dotnet_apphost",
    host = True,
)
use_repo(
    dotnet,
    "dotnet.apphost_packs",
    "dotnet.crossgen2_packs",
    "dotnet.runtime_packs",
    "dotnet.targeting_packs",
    "dotnet_toolchains",
    "dotnet_wasm_workload",
)

# These toolchains are used to build the apphost shimmer
use_repo(dotnet, "dotnet_apphost_x86_64-unknown-linux-gnu")
use_repo(dotnet, "dotnet_apphost_arm64-unknown-linux-gnu")
use_repo(dotnet, "dotnet_apphost_aarch64-apple-darwin")
use_repo(dotnet, "dotnet_apphost_x86_64-apple-darwin")
use_repo(dotnet, "dotnet_apphost_x86_64-pc-windows-msvc")
use_repo(dotnet, "dotnet_apphost_arm64-pc-windows-msvc")

register_toolchains("@dotnet_toolchains//:all")

paket = use_extension("@rules_dotnet//dotnet:paket.bzl", "paket")
paket.parse(
    dependencies = "//:paket.dependencies",
    groups = [
        "blazor_dependencies",
        "paket_cli",
        "sdk_gen_dependencies",
        "rules_dotnet_nuget_packages",
    ],
    lock = "//:paket.lock",
)
use_repo(
    paket,
    "paket.blazor_dependencies",
    "paket.paket_cli",
    "paket.rules_dotnet_nuget_packages",
    "paket.sdk_gen_dependencies",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")

# Dev dependencies
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.50.0", dev_dependency = True, repo_name = "bazel_gazelle")
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.18", dev_dependency = True)
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)
bazel_dep(name = "bazel_ci_rules", version = "1.0.0", dev_dependency = True)
bazel_dep(name = "dotnet_test_resources_other_repo", version = "", dev_dependency = True)
local_path_override(
    module_name = "dotnet_test_resources_other_repo",
    path = "dotnet/private/tests/resources/other_repo",
)

dev_paket = use_extension("@rules_dotnet//dotnet:paket.bzl", "paket", dev_dependency = True)
dev_paket.parse(
    dependencies = "//:paket.dependencies",
    groups = [
        "rules_dotnet_dev_nuget_packages",
        "rules_dotnet_nuget_resource_assemblies_tests",
        "rules_dotnet_framework_override_not_provided_tests",
        "rules_dotnet_nuget_tool_tests",
    ],
    lock = "//:paket.lock",
)
use_repo(
    dev_paket,
    "paket.rules_dotnet_dev_nuget_packages",
    "paket.rules_dotnet_framework_override_not_provided_tests",
    "paket.rules_dotnet_nuget_resource_assemblies_tests",
    "paket.rules_dotnet_nuget_tool_tests",
)

internal_dev_deps = use_extension("@rules_dotnet//dotnet:internal_dev_deps.bzl", "internal_dev_deps", dev_dependency = True)
use_repo(internal_dev_deps, "buildkite_config")
