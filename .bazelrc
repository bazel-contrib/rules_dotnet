startup --windows_enable_symlinks
common --enable_runfiles
common --incompatible_strict_action_env
common --test_output=errors

# Enable persistent workers
build --@rules_dotnet//dotnet/settings:use_compiler_worker=true

# Profiling flags
common --noslim_profile
common --experimental_profile_include_target_label
common --experimental_profile_include_primary_output 
common --experimental_collect_load_average_in_profiler
common --experimental_collect_system_network_usage
common --experimental_collect_worker_data_in_profiler

# Verbose failure output
common --verbose_failures

# The hermetic C/C++ toolchain the NativeAOT and cross-publishing tests link
# with. Only on the hosts that run them: see the note in MODULE.bazel.
common:linux --extra_toolchains=@llvm//toolchain:all
common:macos --extra_toolchains=@llvm//toolchain:all

# Give one cache key to a compilation reached through several configurations.
# Per platform because path mapping requires a sandbox and Bazel has none on
# Windows, where it would fail every compile. See docs/README.md#path-mapping.
common --enable_platform_specific_config
common:linux --experimental_output_paths=strip
common:macos --experimental_output_paths=strip

# Load any settings specific to the current user.
# .bazelrc.user should appear in .gitignore so that settings are not shared with team members
# This needs to be last statement in this
# config, as the user configuration should be able to overwrite flags from this file.
# See https://docs.bazel.build/versions/master/best-practices.html#bazelrc
# (Note that we use .bazelrc.user so the file appears next to .bazelrc in directory listing,
# rather than user.bazelrc as suggested in the Bazel docs)
try-import %workspace%/.bazelrc.user

# Bazel 8 flags that will be flipped
common --incompatible_disallow_empty_glob
# Enable once our dependencies all support this
# common --incompatible_auto_exec_groups
