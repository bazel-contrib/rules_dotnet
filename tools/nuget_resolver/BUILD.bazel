load(
    "//dotnet:defs.bzl",
    "csharp_library",
)

csharp_library(
    name = "nuget_resolver",
    srcs = glob(
        ["*.cs"],
        allow_empty = False,
    ),
    target_frameworks = ["net10.0"],
    visibility = ["//tools:__subpackages__"],
    deps = [
        "@paket.rules_dotnet_nuget_packages//nuget.dependencyresolver.core",
        "@paket.rules_dotnet_nuget_packages//nuget.protocol",
    ],
)
