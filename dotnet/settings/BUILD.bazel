load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# Whether a target compiles only against the assemblies in its own `deps`
# (the default), or against their transitive dependencies too.
bool_flag(
    name = "strict_deps",
    build_setting_default = True,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether a binary runs only on the shared frameworks it references itself
# (the default), or on those its dependencies reference too. A self-contained
# or ReadyToRun `publish_binary` fails when strict and a dependency references
# another one. See docs/README.md#shared-frameworks.
bool_flag(
    name = "strict_framework_references",
    build_setting_default = True,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether the C# and F# compile actions run in a persistent worker.
# See docs/README.md#persistent-workers.
bool_flag(
    name = "use_compiler_worker",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "compiler_worker_enabled",
    flag_values = {":use_compiler_worker": "True"},
    visibility = ["//visibility:public"],
)

# The compiler workers when `use_compiler_worker` is on, and nothing otherwise.
# Aliases, so that a build with the workers off never analyzes them.
alias(
    name = "csharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/csharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "fsharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/fsharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "no_compiler_worker",
    visibility = ["//visibility:public"],
)

# Whether the compilers embed their sources in the PDB.
# See docs/README.md#embedded-sources.
bool_flag(
    name = "embed_all_sources",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "embed_all_sources_enabled",
    flag_values = {":embed_all_sources": "True"},
    visibility = ["//visibility:public"],
)

# Whether the C# compiler runs the .NET SDK's built-in analyzers (`CAxxxx`) by
# default. Individual targets can override this with `enable_net_analyzers`.
bool_flag(
    name = "enable_net_analyzers",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether the C# compiler runs the .NET SDK's built-in code style analyzers
# (`IDExxxx`) by default. Individual targets can override this with
# `enforce_code_style_in_build`.
bool_flag(
    name = "enforce_code_style_in_build",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Whether every .NET process the rules start, compilers, tools, binaries and
# tests alike, runs in globalization-invariant mode. A binary, test or tool
# keeps a DOTNET_SYSTEM_GLOBALIZATION_INVARIANT already in its environment, such
# as one from `envs` or `--test_env`. See docs/README.md#globalization-and-icu.
bool_flag(
    name = "invariant_globalization",
    build_setting_default = False,
    scope = "universal",
    visibility = ["//visibility:public"],
)

# The ICU shared libraries the .NET processes the rules start load on Linux,
# instead of the system's `libicu`: `:system_icu` (the default) or
# `:hermetic_icu`. See docs/README.md#globalization-and-icu.
label_flag(
    name = "icu",
    build_setting_default = ":system_icu",
    scope = "universal",
    visibility = ["//visibility:public"],
)

# Use the ICU installed on the machine.
filegroup(
    name = "system_icu",
    visibility = ["//visibility:public"],
)

# Build ICU from the `icu` module and carry it with the build. Only Linux loads
# ICU from shared libraries, so elsewhere this is the system's.
alias(
    name = "hermetic_icu",
    actual = select({
        "@platforms//os:linux": "//dotnet/private/icu",
        "//conditions:default": ":system_icu",
    }),
    visibility = ["//visibility:public"],
)
