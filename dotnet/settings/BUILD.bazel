load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# A flag controlling if strict dependencies are enforced or not.
bool_flag(
    name = "strict_deps",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# Whether the C# and F# compile actions run in a persistent worker.
# See docs/README.md#persistent-workers.
bool_flag(
    name = "use_compiler_worker",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "compiler_worker_enabled",
    flag_values = {":use_compiler_worker": "True"},
    visibility = ["//visibility:public"],
)

# The workers sit behind an alias so that a workspace that leaves them switched
# off never analyses them.
alias(
    name = "csharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/csharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "fsharp_compiler_worker",
    actual = select({
        ":compiler_worker_enabled": "//dotnet/private/tools/fsharp_compiler_worker",
        "//conditions:default": ":no_compiler_worker",
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "no_compiler_worker",
    visibility = ["//visibility:public"],
)

# Whether a compile reports the references it did not use, so that Bazel stops
# re-running it when only those change. Needs use_compiler_worker, because it is
# the worker that reads the compiled output.
# See docs/README.md#pruning-unused-references.
bool_flag(
    name = "prune_unused_references",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Whether the compilers embed their sources in the PDB.
# See docs/README.md#embedded-sources.
bool_flag(
    name = "embed_all_sources",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "embed_all_sources_enabled",
    flag_values = {":embed_all_sources": "True"},
    visibility = ["//visibility:public"],
)

# Whether every .NET process the rules start runs in globalization-invariant mode.
bool_flag(
    name = "invariant_globalization",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

label_flag(
    name = "icu",
    build_setting_default = ":system_icu",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "system_icu",
    visibility = ["//visibility:public"],
)

alias(
    name = "hermetic_icu",
    actual = select({
        "@platforms//os:linux": "//dotnet/private/icu",
        "//conditions:default": ":system_icu",
    }),
    visibility = ["//visibility:public"],
)
