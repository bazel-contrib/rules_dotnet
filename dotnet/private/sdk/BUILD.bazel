load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "rids",
    srcs = ["rids.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "pack_bands",
    srcs = ["pack_bands.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "packs",
    srcs = ["packs.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":pack_bands"],
)

bzl_library(
    name = "pack_repos",
    srcs = ["pack_repos.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":packs",
        ":versions",
        "//dotnet/private:semver",
        "//dotnet/private/paket:feed",
        "//dotnet/private/rules/nuget:nuget_repo",
        "@bazel_skylib//lib:collections",
    ],
)

bzl_library(
    name = "tool_pack",
    srcs = ["tool_pack.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["//dotnet/private:providers"],
)

bzl_library(
    name = "frameworks",
    srcs = ["frameworks.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)
