load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "rids",
    srcs = ["rids.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "pack_bands",
    srcs = ["pack_bands.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":frameworks"],
)

bzl_library(
    name = "packs",
    srcs = ["packs.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":pack_bands"],
)

bzl_library(
    name = "pack_repos",
    srcs = ["pack_repos.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":pack_bands",
        ":packs",
        ":releases",
        "//dotnet/private/paket:feed",
        "//dotnet/private/rules/nuget:nuget_repo",
        "@bazel_skylib//lib:collections",
    ],
)

bzl_library(
    name = "sdk_too_old",
    srcs = ["sdk_too_old.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":releases"],
)

bzl_library(
    name = "tool_pack",
    srcs = ["tool_pack.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":packs",
        "//dotnet/private:common",
        "//dotnet/private:providers",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "frameworks",
    srcs = ["frameworks.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "releases",
    srcs = ["releases.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":frameworks",
        "//dotnet/private:semver",
        "//dotnet/private:toolchains_repo",
    ],
)
