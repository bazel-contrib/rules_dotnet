load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "ilcompiler_pack",
    srcs = ["ilcompiler_pack.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["//dotnet/private/sdk:tool_pack"],
)

# Resolved against the execution platform, so only the pack for the machine the
# build runs on is ever analyzed or fetched. A select over the host platforms
# or target frameworks would be expanded whole by an unconfigured `bazel query`
# or `bazel fetch`.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)
