# Stands in for a tool attribute on the rules that build rules_dotnet's own
# tools, which cannot point at those tools without depending on themselves.
filegroup(
    name = "no_tool",
    visibility = ["//dotnet:__subpackages__"],
)

# The runtime pack a Blazor WebAssembly application runs on, and the tools that
# publish it, for the framework being published. Behind aliases because a rule
# attribute default cannot itself be a select, and generated from the band table
# so that a new framework needs no edit here.
[
    alias(
        name = name,
        actual = select(
            {
                "//dotnet:tfm_" + tfm: "@dotnet.wasm_packs//{}:{}".format(tfm, target)
                for tfm in wasm_pack_tfms()
            },
            no_match_error = "Blazor WebAssembly needs one of " + ", ".join(sorted(wasm_pack_tfms())),
        ),
        visibility = ["//dotnet:__subpackages__"],
    )
    for (name, target) in {
        "wasm_pack": WASM_RID,
        "wasm_sdk": "wasm_sdk",
        "illink": "illink",
        "devserver": "devserver",
        "internal_assets": "internal_assets",
    }.items()
]

# The crossgen2 pack for the machine the build runs on. Behind an alias
# because a rule attribute default cannot itself be a select; the rule depends
# on this in the exec configuration, so the select resolves to the execution
# platform rather than the target.
alias(
    name = "crossgen2_pack",
    actual = select({
        ":linux-arm64": "@dotnet.crossgen2_packs//tool:linux-arm64",
        ":linux-x64": "@dotnet.crossgen2_packs//tool:linux-x64",
        ":osx-arm64": "@dotnet.crossgen2_packs//tool:osx-arm64",
        ":osx-x64": "@dotnet.crossgen2_packs//tool:osx-x64",
        ":windows-arm64": "@dotnet.crossgen2_packs//tool:win-arm64",
        ":windows-x64": "@dotnet.crossgen2_packs//tool:win-x64",
    }),
    visibility = ["//visibility:public"],
)

# The ILCompiler pack for the machine the build runs on, aliased for the same
# reason as crossgen2 above.
alias(
    name = "ilcompiler_pack",
    actual = select({
        ":linux-arm64": "@dotnet.ilcompiler_packs//tool:linux-arm64",
        ":linux-x64": "@dotnet.ilcompiler_packs//tool:linux-x64",
        ":osx-arm64": "@dotnet.ilcompiler_packs//tool:osx-arm64",
        ":osx-x64": "@dotnet.ilcompiler_packs//tool:osx-x64",
        ":windows-arm64": "@dotnet.ilcompiler_packs//tool:win-arm64",
        ":windows-x64": "@dotnet.ilcompiler_packs//tool:win-x64",
    }),
    visibility = ["//visibility:public"],
)
