# Stands in for a tool attribute on the rules that build rules_dotnet's own
# tools, which cannot point at those tools without depending on themselves.
filegroup(
    name = "no_tool",
    visibility = ["//dotnet:__subpackages__"],
)

# What a framework's band leaves out of the packs below.
filegroup(
    name = "no_pack",
    visibility = ["//dotnet:__subpackages__"],
)

# The runtime pack a Blazor WebAssembly application runs on, and the packs that
# publish it, for the framework being published. Behind aliases because a rule
# attribute default cannot itself be a select, and generated from the band table
# so that a new framework needs no edit here.
#
# Manual, like everything below that picks a band by framework: they only
# resolve in a configuration the framework was set for, rather than in the
# default one, whose framework is the newest declared.
[
    alias(
        name = name,
        actual = select(
            {
                "//dotnet:tfm_" + tfm: (
                    "@{}//{}:{}".format(WASM_PACK_REPO, tfm, target) if target == WASM_RID or target in wasm_tool_pack_names(tfm) else ":no_pack"
                )
                for tfm in wasm_pack_tfms()
            },
            no_match_error = "Blazor WebAssembly needs {} or newer".format(wasm_pack_tfms()[0]),
        ),
        tags = ["manual"],
        visibility = ["//dotnet:__subpackages__"],
    )
    for (name, target) in {
        "wasm_pack": WASM_RID,
        "wasm_sdk": "wasm_sdk",
        "internal_assets": "internal_assets",
    }.items()
]

# The tools that run on the SDK's runtime, whatever the framework, so from its
# own band, as the SDK bundles them.
[
    alias(
        name = name,
        actual = "@{}//{}:{}".format(WASM_PACK_REPO, NEWEST_BAND, name),
        visibility = ["//dotnet:__subpackages__"],
    )
    for name in [
        "illink",
        "devserver",
    ]
]

# The crossgen2 pack of the target framework's band, for the machine the build
# runs on.
host_tool_pack(
    name = "crossgen2_pack",
    pack = host_tool_pack_band(
        CROSSGEN2_PACK_REPO,
        host_tool_tfms(crossgen2_pack),
    ),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The ILCompiler pack, chosen the same way as crossgen2 above.
host_tool_pack(
    name = "ilcompiler_pack",
    pack = host_tool_pack_band(
        ILCOMPILER_PACK_REPO,
        host_tool_tfms(ilcompiler_pack),
    ),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
