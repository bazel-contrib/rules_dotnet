load(
    "//dotnet/private/rules/csharp:binary.bzl",
    "bootstrap_tool_binary",
)

# Runs the SDK's own scoped CSS tasks. See Program.cs for why the tasks are
# instantiated rather than reimplemented.
bootstrap_tool_binary(
    name = "scoped_css",
    srcs = ["Program.cs"],
    include_msbuild_dlls = True,
    nullable = "enable",
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)
