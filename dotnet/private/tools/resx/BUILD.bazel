load(
    "//dotnet/private/rules/csharp:binary.bzl",
    "bootstrap_tool_binary",
)

# Compiles `.resx` files by running the SDK's own GenerateResource task. See
# Program.cs.
bootstrap_tool_binary(
    name = "resx",
    srcs = [
        "Program.cs",
        "//dotnet/private/tools/msbuild:srcs",
    ],
    include_msbuild_dlls = True,
    nullable = "enable",
    target_frameworks = ["net11.0"],
    visibility = ["//visibility:public"],
)
