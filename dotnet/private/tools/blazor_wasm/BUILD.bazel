load(
    "//dotnet/private/rules/csharp:binary.bzl",
    "bootstrap_tool_binary",
)

# Assembles the `_framework` directory a Blazor WebAssembly application boots
# from. See Program.cs.
bootstrap_tool_binary(
    name = "blazor_wasm",
    srcs = [
        "BootConfig.cs",
        "Program.cs",
        "Trimming.cs",
        "Webcil.cs",
        "//dotnet/private/tools/msbuild:srcs",
    ],
    include_msbuild_dlls = True,
    nullable = "enable",
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)
