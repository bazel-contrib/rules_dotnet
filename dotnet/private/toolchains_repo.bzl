"""Declares the repository of `toolchain` targets for one .NET SDK.

Bazel analyzes every registered `toolchain` target to resolve toolchains, but
not the `dotnet_toolchain` each one points at. Keeping the `toolchain` targets
in a repository of their own means the SDK is only downloaded once a build
needs it.
"""

# The toolchain type an SDK registers for: `DOTNET_TOOLCHAIN_TYPE` for the SDK
# the user builds with, `BOOTSTRAP_TOOLCHAIN_TYPE` for the one rules_dotnet
# builds its own tools with.
DOTNET_TOOLCHAIN_TYPE = "@rules_dotnet//dotnet/toolchain:toolchain_type"
BOOTSTRAP_TOOLCHAIN_TYPE = "@rules_dotnet//dotnet/toolchain:bootstrap_toolchain_type"

# Add more platforms as needed to mirror all the binaries
# published by the upstream project. `rid` names the platform's SDK archive in
# the release metadata.
PLATFORMS = {
    "x86_64-apple-darwin": struct(
        rid = "osx-x64",
        os = "osx",
        compatible_with = [
            "@platforms//os:macos",
            "@platforms//cpu:x86_64",
        ],
    ),
    "aarch64-apple-darwin": struct(
        rid = "osx-arm64",
        os = "osx",
        compatible_with = [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
    ),
    "x86_64-unknown-linux-gnu": struct(
        rid = "linux-x64",
        os = "linux",
        compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    ),
    "arm64-unknown-linux-gnu": struct(
        rid = "linux-arm64",
        os = "linux",
        compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:arm64",
        ],
    ),
    "x86_64-pc-windows-msvc": struct(
        rid = "win-x64",
        os = "windows",
        compatible_with = [
            "@platforms//os:windows",
            "@platforms//cpu:x86_64",
        ],
    ),
    "arm64-pc-windows-msvc": struct(
        rid = "win-arm64",
        os = "windows",
        compatible_with = [
            "@platforms//os:windows",
            "@platforms//cpu:arm64",
        ],
    ),
}

def _toolchains_repo_impl(repository_ctx):
    build_content = """# Generated by toolchains_repo.bzl
#
# These are registered by the `dotnet` module extension, or can be passed to the
# --extra_toolchains flag, so you don't normally need to interact with them.
"""

    for [platform, meta] in PLATFORMS.items():
        build_content += """
# Declare a toolchain Bazel will select for running the tool in an action
# on the execution platform.
toolchain(
    name = "{platform}_toolchain",
    exec_compatible_with = {compatible_with},
    toolchain = "@{sdk_repository_name}_{platform}//:dotnet_toolchain",
    toolchain_type = "{toolchain_type}",
)
""".format(
            platform = platform,
            sdk_repository_name = repository_ctx.attr.sdk_repository_name,
            compatible_with = meta.compatible_with,
            toolchain_type = repository_ctx.attr.toolchain_type,
        )

    # Base BUILD file for this repository
    repository_ctx.file("BUILD.bazel", build_content)

toolchains_repo = repository_rule(
    _toolchains_repo_impl,
    doc = "Creates a repository with a `toolchain` target for every platform in `PLATFORMS`.",
    attrs = {
        "toolchain_type": attr.string(
            doc = "The toolchain type the generated `toolchain` targets register for.",
            default = DOTNET_TOOLCHAIN_TYPE,
        ),
        "sdk_repository_name": attr.string(
            doc = "Base name of the per-platform repositories holding the SDK these toolchains point at.",
        ),
    },
)
