load("//dotnet/private/rules/nuget:imports.bzl", "import_library")

exports_files(
    [
        "shim.cs",
    ],
    visibility = ["//visibility:public"],
)

# The `MSTest.TestAdapter` nupkg ships its assemblies under `buildTransitive/`
# only (there is no `lib/` folder), so the paket-generated `import_library` for
# `@paket.rules_dotnet_nuget_packages//mstest.testadapter` has empty `libs` and
# cannot be used as a compile or runtime dependency. `AddMSTest` — the
# Microsoft.Testing.Platform entry point used by `shim.cs` — lives in
# `Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll`, so we import the
# `buildTransitive/` assemblies of the pinned package here.
#
# The DLLs are selected on the target framework, mirroring the package layout:
# buildTransitive/{netstandard2.0,net6.0,net7.0,net8.0,net9.0}/...
_MSTEST_TESTADAPTER_NET60 = [
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net6.0/Microsoft.TestPlatform.AdapterUtilities.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net6.0/Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net6.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll",
]

_MSTEST_TESTADAPTER_NET70 = [
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net7.0/Microsoft.TestPlatform.AdapterUtilities.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net7.0/Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net7.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll",
]

_MSTEST_TESTADAPTER_NET80 = [
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net8.0/Microsoft.TestPlatform.AdapterUtilities.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net8.0/Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net8.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll",
]

_MSTEST_TESTADAPTER_NET90 = [
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net9.0/Microsoft.TestPlatform.AdapterUtilities.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net9.0/Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/net9.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll",
]

_MSTEST_TESTADAPTER_NETSTANDARD20 = [
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/netstandard2.0/Microsoft.TestPlatform.AdapterUtilities.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/netstandard2.0/Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.dll",
    "@@+paket+nuget.mstest.testadapter.v3.11.1//:buildTransitive/netstandard2.0/Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.dll",
]

import_library(
    name = "mstest_testadapter",
    library_name = "Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter",
    version = "3.11.1",
    libs = select({
        "//dotnet:tfm_net6.0": _MSTEST_TESTADAPTER_NET60,
        "//dotnet:tfm_net7.0": _MSTEST_TESTADAPTER_NET70,
        "//dotnet:tfm_net8.0": _MSTEST_TESTADAPTER_NET80,
        "//dotnet:tfm_net9.0": _MSTEST_TESTADAPTER_NET90,
        "//dotnet:tfm_net10.0": _MSTEST_TESTADAPTER_NET90,
        "//conditions:default": _MSTEST_TESTADAPTER_NETSTANDARD20,
    }),
    refs = select({
        "//dotnet:tfm_net6.0": _MSTEST_TESTADAPTER_NET60,
        "//dotnet:tfm_net7.0": _MSTEST_TESTADAPTER_NET70,
        "//dotnet:tfm_net8.0": _MSTEST_TESTADAPTER_NET80,
        "//dotnet:tfm_net9.0": _MSTEST_TESTADAPTER_NET90,
        "//dotnet:tfm_net10.0": _MSTEST_TESTADAPTER_NET90,
        "//conditions:default": _MSTEST_TESTADAPTER_NETSTANDARD20,
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":mstest_testframework_extensions",
        "@paket.rules_dotnet_nuget_packages//mstest.testframework",
    ],
    nupkg = "@@+paket+nuget.mstest.testadapter.v3.11.1//:mstest.testadapter.3.11.1.nupkg",
    sha512 = "sha512-xaPEvxRzG6lVz/4QPKikbYHo98DHOEq/4uswr70xN8kX2jJPRLkFThZTlAp93bVekkm5ciWDBZmm9VPsGpjfwA==",
)

# Same story for `MSTest.TestFramework`: for net6.0 and above its
# `Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll` moved from
# `lib/` to `buildTransitive/`, so the paket-generated package target omits it
# and the adapter cannot discover tests without it.
_MSTEST_TESTFRAMEWORK_EXTENSIONS_NET60 = [
    "@@+paket+nuget.mstest.testframework.v3.11.1//:buildTransitive/net6.0/Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll",
]

_MSTEST_TESTFRAMEWORK_EXTENSIONS_NET70 = [
    "@@+paket+nuget.mstest.testframework.v3.11.1//:buildTransitive/net7.0/Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll",
]

_MSTEST_TESTFRAMEWORK_EXTENSIONS_NET80 = [
    "@@+paket+nuget.mstest.testframework.v3.11.1//:buildTransitive/net8.0/Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll",
]

_MSTEST_TESTFRAMEWORK_EXTENSIONS_NET90 = [
    "@@+paket+nuget.mstest.testframework.v3.11.1//:buildTransitive/net9.0/Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll",
]

_MSTEST_TESTFRAMEWORK_EXTENSIONS_NETSTANDARD20 = [
    "@@+paket+nuget.mstest.testframework.v3.11.1//:lib/netstandard2.0/Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions.dll",
]

import_library(
    name = "mstest_testframework_extensions",
    library_name = "Microsoft.VisualStudio.TestPlatform.TestFramework.Extensions",
    version = "3.11.1",
    libs = select({
        "//dotnet:tfm_net6.0": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NET60,
        "//dotnet:tfm_net7.0": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NET70,
        "//dotnet:tfm_net8.0": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NET80,
        "//dotnet:tfm_net9.0": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NET90,
        "//dotnet:tfm_net10.0": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NET90,
        "//conditions:default": _MSTEST_TESTFRAMEWORK_EXTENSIONS_NETSTANDARD20,
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@paket.rules_dotnet_nuget_packages//mstest.testframework",
    ],
    nupkg = "@@+paket+nuget.mstest.testframework.v3.11.1//:mstest.testframework.3.11.1.nupkg",
    sha512 = "sha512-DnYDVrd8HPk3PXJ95IZTgGcgBWozd5O/kbMldO5T54cEDK5tq4mBBtSX7wS/7lEFz2nzA5xG/tp7S+RLiqFyqw==",
)
