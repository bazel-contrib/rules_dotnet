load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "binary",
    srcs = ["binary.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":static_web_assets",
        "//dotnet/private:common",
        "//dotnet/private:providers",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "embed_sources",
    srcs = ["embed_sources.bzl"],
    visibility = ["//dotnet:__subpackages__"],
)

bzl_library(
    name = "static_web_assets",
    srcs = ["static_web_assets.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["//dotnet/private:providers"],
)

bzl_library(
    name = "publish_layout",
    srcs = ["publish_layout.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["//dotnet/private:common"],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":static_web_assets",
        "//dotnet/private:common",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "attrs",
    srcs = ["attrs.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":static_web_assets",
        "//dotnet/private:providers",
        "//dotnet/private/sdk:packs",
        "//dotnet/private/sdk/apphost_packs:apphost_pack_transition",
        "//dotnet/private/sdk/runtime_packs:runtime_pack_transition",
        "//dotnet/private/sdk/targeting_packs:targeting_pack_transition",
        "//dotnet/private/transitions:default_transition",
        "@bazel_lib//lib:expand_make_vars",
        "@bazel_skylib//lib:dicts",
    ],
)
