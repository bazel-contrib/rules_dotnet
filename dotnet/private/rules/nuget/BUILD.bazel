load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "imports",
    srcs = ["imports.bzl"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private:providers",
    ],
)

bzl_library(
    name = "nuget_archive",
    srcs = ["nuget_archive.bzl"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        ":dotnet_tool",
        ":package_metadata",
        "//dotnet/private:common",
        "//dotnet/private:portable_rids",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "package_metadata",
    srcs = ["package_metadata.bzl"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private:xml",
    ],
)

bzl_library(
    name = "package",
    srcs = ["package.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":dotnet_tool",
        ":imports",
        ":package_metadata",
        "//dotnet/private:common",
    ],
)

bzl_library(
    name = "nuget_repo",
    srcs = ["nuget_repo.bzl"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        "//dotnet/private/rules/nuget:nuget_archive",
