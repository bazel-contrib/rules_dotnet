)

bzl_library(
    name = "dotnet_tool",
    srcs = ["dotnet_tool.bzl"],
    visibility = [
        "//docs:__subpackages__",
        "//dotnet:__subpackages__",
    ],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private/icu:settings",
    ],
)
