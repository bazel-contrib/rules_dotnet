load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_setting", "string_setting")
load(":native_tools.bzl", "native_tools")

# True only on the edge from a publish to its binary, so that the binary can
# tell itself apart from a binary it depends on.
bool_setting(
    name = "published",
    build_setting_default = False,
    scope = "target",
    visibility = ["//visibility:public"],
)

# The native compiler a ReadyToRun or NativeAOT publish asks its binary for.
# Only the binary keeps it; see //dotnet/private/transitions:tfm_transition.
string_setting(
    name = "native_compiler",
    build_setting_default = "",
    scope = "target",
    values = [
        "",
        "crossgen2",
        "ilcompiler",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "crossgen2",
    flag_values = {":native_compiler": "crossgen2"},
)

config_setting(
    name = "ilcompiler",
    flag_values = {":native_compiler": "ilcompiler"},
)

# Nothing unless a publish asked, so that no other build analyses the packs.
alias(
    name = "native_tools",
    actual = select({
        ":crossgen2": ":crossgen2_tools",
        ":ilcompiler": ":ilcompiler_tools",
        "//conditions:default": ":no_native_tools",
    }),
    visibility = ["//dotnet:__subpackages__"],
)

filegroup(
    name = "no_native_tools",
)

# Manual: they only resolve in a binary whose publish asked for them.
native_tools(
    name = "crossgen2_tools",
    crossgen2 = "//dotnet/private:crossgen2_pack",
    tags = ["manual"],
)

native_tools(
    name = "ilcompiler_tools",
    ilcompiler = "//dotnet/private:ilcompiler_pack",
    nativeaot_pack = "//dotnet/private/sdk/nativeaot_packs:nativeaot_pack",
    tags = ["manual"],
)

bzl_library(
    name = "native_tools_bzl",
    srcs = ["native_tools.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:providers",
        "//dotnet/private/sdk/nativeaot_packs:nativeaot_pack_transition",
    ],
)

bzl_library(
    name = "publish_binary",
    srcs = ["publish_binary.bzl"],
    visibility = [
        "//dotnet:__subpackages__",
    ],
    deps = [
        "//dotnet/private:providers",
        "//dotnet/private/rules/blazor:blazor_wasm_publish",
        "//dotnet/private/rules/common:publish_layout",
        "//dotnet/private/rules/ready_to_run",
        "//dotnet/private/sdk/runtime_packs:runtime_pack_transition",
        "//dotnet/private/transitions:default_transition",
        "//dotnet/private/transitions:tfm_transition",
        "@bazel_skylib//lib:paths",
        "@bazel_skylib//lib:shell",
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc/common",
    ],
)
