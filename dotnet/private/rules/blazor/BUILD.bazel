load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "common",
    srcs = ["common.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:providers",
        "//dotnet/private/rules/common:static_web_assets",
        "//dotnet/private/sdk:packs",
        "//dotnet/private/transitions:wasm_pack_transition",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "blazor_wasm_publish",
    srcs = ["blazor_wasm_publish.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:providers",
        "//dotnet/private/transitions:tfm_transition",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "devserver",
    srcs = ["devserver.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:common",
        "//dotnet/private:providers",
    ],
)

bzl_library(
    name = "blazor_wasm_binary",
    srcs = ["blazor_wasm_binary.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        ":devserver",
        "//dotnet/private:providers",
        "//dotnet/private/transitions:tfm_transition",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "app",
    srcs = ["app.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [":blazor_wasm_binary"],
)
