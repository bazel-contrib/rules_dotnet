load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "component",
    srcs = ["component.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:providers",
        "//dotnet/private/rules/csharp:global_usings",
        "//dotnet/private/transitions:default_transition",
    ],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private:providers",
        "//dotnet/private/rules/common:attrs",
        "//dotnet/private/rules/common:stamping",
        "//dotnet/private/rules/csharp/actions:csharp_assembly",
        "//dotnet/private/transitions:default_transition",
        "//dotnet/private/transitions:tfm_transition",
        "//proto/private:providers",
        "@bazel_skylib//lib:dicts",
        "@bazel_skylib//rules:common_settings",
    ],
)

bzl_library(
    name = "publish",
    srcs = ["publish.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private:providers",
        "//dotnet/private/rules/csharp/actions:csharp_assembly",
        "//dotnet/private/transitions:default_transition",
        "//dotnet/private/transitions:tfm_transition",
        "@bazel_skylib//lib:dicts",
    ],
)
