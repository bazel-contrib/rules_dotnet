load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "csharp_assembly",
    srcs = ["csharp_assembly.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":razor",
        ":scoped_css",
        ":sdk_analyzers",
        ":xaml",
        "//dotnet/private:common",
        "//dotnet/private:nuget_version",
        "//dotnet/private:providers",
        "//dotnet/private/rules/common:compiler_action",
        "//dotnet/private/rules/common:resx",
        "//dotnet/private/sdk:packs",
        "@bazel_skylib//lib:structs",
    ],
)

bzl_library(
    name = "sdk_analyzers",
    srcs = ["sdk_analyzers.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private/sdk:packs",
    ],
)

bzl_library(
    name = "scoped_css",
    srcs = ["scoped_css.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":razor",
        "//dotnet/private/rules/common:static_web_assets",
    ],
)

bzl_library(
    name = "razor",
    srcs = ["razor.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:common",
        "@bazel_lib//lib:base64",
    ],
)

bzl_library(
    name = "xaml",
    srcs = ["xaml.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = ["//dotnet/private/sdk:packs"],
)
