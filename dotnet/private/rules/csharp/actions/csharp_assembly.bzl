def _write_internals_visible_to_csharp(actions, label_name, dll_name, others):
    """Writes a .cs file declaring each of `others` a friend assembly.

    Args:
      actions: An actions module, usually from ctx.actions.
      label_name: The label name.
      dll_name: The assembly name.
      others: The names of the friend assemblies.

    Returns:
      The generated .cs file.
    """
    attrs = actions.args()
    attrs.set_param_file_format(format = "multiline")
    attrs.add_all(
        others,
        format_each = "[assembly: System.Runtime.CompilerServices.InternalsVisibleTo(\"%s\")]",
    )

    output = actions.declare_file("%s/%s/internalsvisibleto.cs" % (label_name, dll_name))
    actions.write(output, attrs)

    return output

def _write_assembly_info_csharp(actions, label_name, dll_name, version, user_secrets_id, platform):
    """Writes a .cs file carrying the assembly version, user-secrets and platform attributes.

    Args:
      actions: An actions module, usually from ctx.actions.
      label_name: The label name.
      dll_name: The assembly name.
      version: The target's `version` attribute; "" when unset.
      user_secrets_id: The target's `user_secrets_id` attribute; "" when unset.
      platform: The platform of a platform specific framework, from `target_platform`, or None.

    Returns:
      The generated .cs file, or None when there is nothing to write.
    """
    if not version and not user_secrets_id and not platform:
        return None

    lines = ["// Generated by rules_dotnet."]
    if version:
        # Fails on an invalid version, which is the earliest point that can say so.
        numeric = nuget_version.assembly_version(version)
        lines.extend([
            "[assembly: System.Reflection.AssemblyVersion(\"%s\")]" % numeric,
            "[assembly: System.Reflection.AssemblyFileVersion(\"%s\")]" % numeric,
            "[assembly: System.Reflection.AssemblyInformationalVersion(\"%s\")]" % version,
        ])
    if user_secrets_id:
        escaped = user_secrets_id.replace("\\", "\\\\").replace("\"", "\\\"")
        lines.append(
            "[assembly: Microsoft.Extensions.Configuration.UserSecrets.UserSecretsIdAttribute(\"%s\")]" % escaped,
        )
    if platform:
        # As the SDK writes them for a platform specific framework.
        lines.extend([
            "[assembly: System.Runtime.Versioning.TargetPlatform(\"%s\")]" % platform,
            "[assembly: System.Runtime.Versioning.SupportedOSPlatform(\"%s\")]" % platform,
        ])
    lines.append("")

    output = actions.declare_file("%s/%s/assemblyinfo.cs" % (label_name, dll_name))
    actions.write(output, "\n".join(lines))

    return output

def _runs_only_in_the_compiler(dep):
    """Whether a dependency is an analyzer or source generator built in this workspace.

    Nothing loads one at run time, so like a ProjectReference with
    `ReferenceOutputAssembly="false"` it stays out of deps.json and out of a
    pack. A NuGet package is kept, as MSBuild keeps a PackageReference.
    """
    compile_info = dep[DotnetAssemblyCompileInfo]

    return (
        dep[DotnetAssemblyRuntimeInfo].nuget_info == None and
        not compile_info.refs and
        bool(compile_info.analyzers or compile_info.analyzers_csharp)
    )

def _collect_analyzer_dependencies(deps, analyzer_runtime_deps):
    """Collects the assemblies an analyzer loads, to hand to the compiler beside it.

    Those are every library built in this workspace that it depends on, directly
    or not, and its `analyzer_runtime_deps`. Other NuGet packages stay out: the
    compiler brings Roslyn, and Roslyn's own assemblies handed over as analyzers
    would load its compiler diagnostic analyzer, which crashes a `/refonly` compile.

    Args:
        deps: Everything the analyzer compiles against, `analyzer_runtime_deps` included.
        analyzer_runtime_deps: The NuGet packages the analyzer lists.

    Returns:
        The assemblies to hand to the compiler beside the analyzer.
    """
    built_here = [dep[DotnetAssemblyRuntimeInfo] for dep in deps if dep[DotnetAssemblyRuntimeInfo].nuget_info == None]
    closure = depset(built_here, transitive = [info.deps for info in built_here]).to_list()
    loaded = [info for info in closure if info.nuget_info == None]
    loaded += [dep[DotnetAssemblyRuntimeInfo] for dep in analyzer_runtime_deps]

    return {dll: None for info in loaded for dll in info.libs}.keys()

# The source generators the .NET SDK drops unless the project turns them on, and
# the namespace each one's interceptors live in. See `ResolveOffByDefaultAnalyzers`
# in Microsoft.NET.Sdk.FrameworkReferenceResolution.targets.
_REQUEST_DELEGATE_GENERATOR = struct(
    dll = "Microsoft.AspNetCore.Http.RequestDelegateGenerator.dll",
    interceptors_namespace = "Microsoft.AspNetCore.Http.Generated",
)
_CONFIGURATION_BINDING_GENERATOR = struct(
    dll = "Microsoft.Extensions.Configuration.Binder.SourceGeneration.dll",
    interceptors_namespace = "Microsoft.Extensions.Configuration.Binder.SourceGeneration",
)

# Allowed for every project on .NET 10 or later, for ASP.NET Core's validation generator.
_VALIDATION_INTERCEPTORS_NAMESPACE = "Microsoft.Extensions.Validation.Generated"

def _off_by_default_generators(project_sdk, target_framework, publish_trimmed, enable_request_delegate_generator, enable_configuration_binding_generator):
    """Decides which of the SDK's off-by-default generators run, as MSBuild does.

    Args:
        project_sdk: The project SDK named on the target.
        target_framework: The target framework.
        publish_trimmed: Whether a publish trims the target, MSBuild's
            `PublishTrimmed` or `PublishAot`.
        enable_request_delegate_generator: The target's tri-state attribute.
        enable_configuration_binding_generator: The target's tri-state attribute.

    Returns:
        A struct of the generator DLLs to leave out, and the interceptors
        namespaces the SDK allows.
    """

    # The Blazor WebAssembly SDK always trims, but turns the binding generator back off.
    trimmed = publish_trimmed or project_sdk == BLAZORWASM_SDK
    enabled = [
        (_REQUEST_DELEGATE_GENERATOR, resolve_tristate(enable_request_delegate_generator, trimmed)),
        (_CONFIGURATION_BINDING_GENERATOR, resolve_tristate(
            enable_configuration_binding_generator,
            trimmed and project_sdk != BLAZORWASM_SDK,
        )),
    ]

    namespaces = [generator.interceptors_namespace for generator, on in enabled if on]
    if is_core_framework(target_framework) and is_greater_or_equal_framework(target_framework, "net10.0"):
        namespaces.append(_VALIDATION_INTERCEPTORS_NAMESPACE)

    return struct(
        excluded = [generator.dll for generator, on in enabled if not on],
        interceptors_namespaces = namespaces,
    )

def _without_analyzers(analyzers, excluded):
    """Drops the analyzers whose file name is a key of `excluded`, or returns `analyzers` itself when none is."""
    files = analyzers.to_list()
    kept = [dll for dll in files if dll.basename not in excluded]
    return analyzers if len(kept) == len(files) else depset(kept)

def _analyzer_inputs(
        *,
        toolchain,
        target_framework,
        project_sdk,
        analyzers,
        analyzers_csharp,
        analyzer_configs,
        run_analyzers,
        enable_net_analyzers,
        enforce_code_style_in_build,
        analysis_mode,
        excluded_analyzers,
        publish_trimmed,
        enable_request_delegate_generator,
        enable_configuration_binding_generator,
        interceptors_namespaces):
    """Resolves the analyzers, analyzer configs and interceptors namespaces of a compile, as MSBuild does.

    Args:
        toolchain: The resolved .NET toolchain.
        target_framework: The target framework.
        project_sdk: The project SDK named on the target.
        analyzers: The language-agnostic analyzers the dependencies bring.
        analyzers_csharp: The C# analyzers the dependencies bring.
        analyzer_configs: The target's `analyzer_configs`.
        run_analyzers: The target's `run_analyzers`.
        enable_net_analyzers: Whether to run the SDK's code quality analyzers.
        enforce_code_style_in_build: Whether to run the SDK's code style analyzers.
        analysis_mode: The target's `analysis_mode`.
        excluded_analyzers: The target's `excluded_analyzers`.
        publish_trimmed: Whether a publish trims the target.
        enable_request_delegate_generator: The target's tri-state attribute.
        enable_configuration_binding_generator: The target's tri-state attribute.
        interceptors_namespaces: The target's `interceptors_namespaces`.

    Returns:
        A struct of the `analyzers`, `analyzers_csharp` and `analyzer_configs` of
        the compile, the `ref_only_analyzers_csharp` and `ref_only_analyzer_configs`
        of a `/refonly` compile, and the `interceptors_namespaces` to allow.
    """
    sdk_analyzers = sdk_analyzer_compile_inputs(
        toolchain = toolchain,
        target_framework = target_framework,
        project_sdk = project_sdk,
        enable_net_analyzers = run_analyzers and enable_net_analyzers,
        enforce_code_style_in_build = run_analyzers and enforce_code_style_in_build,
        analysis_mode = analysis_mode,
    )
    generators = _off_by_default_generators(
        project_sdk,
        target_framework,
        publish_trimmed,
        enable_request_delegate_generator,
        enable_configuration_binding_generator,
    )

    # Only this compilation drops them; the providers keep them for dependents.
    excluded = {dll: None for dll in excluded_analyzers + generators.excluded}

    return struct(
        analyzers = _without_analyzers(analyzers, excluded),
        analyzers_csharp = _without_analyzers(depset(sdk_analyzers.analyzers, transitive = [analyzers_csharp]), excluded),
        # The SDK's configs come first, so that `analyzer_configs` override their severities.
        analyzer_configs = sdk_analyzers.analyzer_configs + analyzer_configs,
        # A `/refonly` compile reports no diagnostics, so it skips the SDK's analyzers.
        ref_only_analyzers_csharp = _without_analyzers(analyzers_csharp, excluded),
        ref_only_analyzer_configs = analyzer_configs,
        interceptors_namespaces = {
            namespace: None
            for namespace in interceptors_namespaces + generators.interceptors_namespaces
        }.keys(),
    )

def _scoped_css(actions, *, label, partitioned, deps, out_dir, assembly_name, is_application, scoped_css_tool, toolchain):
    """Bundles the target's `.razor.css`, or returns None when it has none."""
    if not partitioned.scoped_css:
        return None

    if not partitioned.razor:
        fail(
            "%s has scoped CSS but no Razor sources: %s.\n" % (
                label,
                ", ".join([src.short_path for src in partitioned.scoped_css]),
            ) +
            "A `<component>.razor.css` only applies to the `<component>.razor` beside it.",
        )

    # An application's bundle imports its libraries' bundles, so it has to
    # know where each of those is served from.
    project_bundles = []
    if is_application:
        dep_assets = depset(transitive = [
            dep[StaticWebAssetsInfo].assets
            for dep in deps
            if StaticWebAssetsInfo in dep
        ])
        project_bundles = [asset.serving_path for asset in dep_assets.to_list() if asset.scoped_css_bundle]

    return scoped_css_action(
        actions,
        label = label,
        out_dir = out_dir,
        assembly_name = assembly_name,
        is_application = is_application,
        scoped_css_srcs = partitioned.scoped_css,
        project_bundles = sorted(project_bundles),
        tool = scoped_css_tool,
        toolchain = toolchain,
    )

def _razor(actions, *, label, partitioned, scoped_css, out_dir, root_namespace, target_framework, project_sdk, toolchain):
    """Stages the target's Razor sources for the Razor generator, or returns None when it has none."""
    if not partitioned.razor:
        return None

    if not uses_razor(project_sdk):
        fail(
            "%s has Razor sources but `project_sdk = %r`.\n" % (label, project_sdk) +
            "Set `project_sdk` to \"razor\" for a Razor class library, or \"web\" for an " +
            "ASP.NET Core application. Razor sources: %s" % (
                ", ".join([src.short_path for src in partitioned.razor]),
            ),
        )

    return razor_compile_inputs(
        actions,
        label = label,
        out_dir = out_dir,
        root_namespace = root_namespace,
        target_framework = target_framework,
        razor_srcs = partitioned.razor,
        toolchain = toolchain,
        extra_configs = [scoped_css.scope_config] if scoped_css else [],
    )

# buildifier: disable=unnamed-macro
def AssemblyAction(
        actions,
        compiler_wrapper,
        compiler_worker,
        label,
        additionalfiles,
        debug,
        embed_sources,
        defines,
        deps,
        exports,
        targeting_pack,
        internals_visible_to,
        keyfile,
        langversion,
        resources,
        resx,
        srcs,
        data,
        appsetting_files,
        content_file_mappings,
        compile_data,
        out,
        target,
        target_name,
        target_framework,
        version,
        toolchain,
        strict_deps,
        generate_documentation_file,
        include_host_model_dll,
        include_msbuild_dlls,
        treat_warnings_as_errors,
        warnings_as_errors,
        warnings_not_as_errors,
        warning_level,
        nowarn,
        project_sdk,
        root_namespace,
        scoped_css_tool,
        allow_unsafe_blocks,
        nullable,
        run_analyzers,
        enable_net_analyzers,
        enforce_code_style_in_build,
        analysis_mode,
        is_analyzer,
        is_language_specific_analyzer,
        analyzer_configs,
        compiler_options,
        interceptors_namespaces,
        is_windows,
        excluded_analyzers = [],
        enable_request_delegate_generator = "default",
        enable_configuration_binding_generator = "default",
        publish_trimmed = False,
        analyzer_runtime_deps = [],
        user_secrets_id = "",
        frameworks = {},
        xaml_tool = None,
        wpf_resources = [],
        implicit_usings = False,
        global_usings = [],
        excluded_global_usings = []):
    """Creates the actions that compile a C# assembly.

    The arguments map onto the [C# compiler options](https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-options/).

    Args:
        actions: Bazel module providing functions to create actions.
        compiler_wrapper: The wrapper script that invokes the C# compiler.
        compiler_worker: The persistent worker to compile with, or None to fall back to the wrapper script.
        label: The label of the target. This is used to determine the relative path of embedded resources.
        additionalfiles: Names additional files that don't directly affect code generation but may be used by analyzers for producing errors or warnings.
        debug: Emits debugging information.
        embed_sources: Embeds the sources in the PDB.
        defines: The list of conditional compilation symbols.
        deps: The list of other libraries to be linked in to the assembly.
        exports: List of exported targets.
        targeting_pack: The targeting pack being used.
        internals_visible_to: An optional list of assemblies that can see this assemblies internal symbols.
        keyfile: Specifies a strong name key file of the assembly.
        langversion: The C# language version.
        resources: The list of resources to be embedded in the assembly.
        resx: The `.resx` resources to compile, from `split_resources`, or None.
        srcs: The source files that are processed to create the assembly.
        data: List of files that are a direct runtime dependency
        appsetting_files: List of appsettings files to include in the output.
        content_file_mappings: List of `struct(src = File, dest = string)` describing content files to copy next to the assembly, where `dest` is the path relative to the output directory.
        compile_data: List of files that are a direct compile time dependency
        target_name: A unique name for this target.
        out: Specifies the output file name.
        target: Specifies the format of the output file by using one of four options.
        target_framework: The target framework moniker for the assembly.
        version: The assembly version as a NuGet version string, or "" for none.
        toolchain: The toolchain that supply the C# compiler.
        strict_deps: Whether or not to use strict dependencies.
        generate_documentation_file: Whether or not to output XML docs for the compiled dll.
        include_host_model_dll: Whether or not to include the Microsoft.NET.HostModel dll. ONLY USED FOR COMPILING THE APPHOST SHIMMER.
        include_msbuild_dlls: Whether or not to include the MSBuild interfaces. ONLY USED FOR COMPILING TOOLS THAT RUN AN SDK BUILD TASK.
        treat_warnings_as_errors: Whether or not to treat warnings as errors.
        warnings_as_errors: List of warnings to treat as errors.
        warnings_not_as_errors: List of warnings to not treat errors.
        warning_level: The warning level to use.
        nowarn: List of warnings to suppress.
        project_sdk: The project sdk being targeted
        root_namespace: The root namespace Razor derives component namespaces from.
        scoped_css_tool: The tool that rewrites `.razor.css`.
        allow_unsafe_blocks: Compiles the target with /unsafe
        nullable: Enable nullable context, or nullable warnings.
        run_analyzers: Enable analyzers.
        enable_net_analyzers: Run the .NET SDK's built-in code quality analyzers (`CAxxxx`).
        enforce_code_style_in_build: Run the .NET SDK's built-in C# code style analyzers (`IDExxxx`).
        analysis_mode: Rule severity preset for the .NET SDK's built-in analyzers.
        is_analyzer: Whether or not the target is an analyzer.
        is_language_specific_analyzer: Whether or not the target is a language specific analyzer.
        analyzer_configs: List of analyzer configuration files.
        compiler_options: Additional options to pass to the compiler.
        interceptors_namespaces: Namespaces that are allowed to contain interceptors.
        is_windows: Whether or not the target is running on Windows.
        excluded_analyzers: File names of analyzer and source generator DLLs to leave out of the compilation.
        enable_request_delegate_generator: MSBuild's `EnableRequestDelegateGenerator`: `"true"`, `"false"`, or `"default"`.
        enable_configuration_binding_generator: MSBuild's `EnableConfigurationBindingGenerator`: `"true"`, `"false"`, or `"default"`.
        publish_trimmed: Whether a publish trims this assembly, MSBuild's `PublishTrimmed` or `PublishAot`.
        analyzer_runtime_deps: The NuGet packages an analyzer loads, which it also compiles against.
        user_secrets_id: The user secrets ID (`<UserSecretsId>` in MSBuild), or "" for none.
        frameworks: The shared frameworks the assembly references beyond Microsoft.NETCore.App, as `resolve_framework_references` returns them.
        xaml_tool: The tool that compiles WPF XAML.
        wpf_resources: Files embedded in `<assembly name>.g.resources` for WPF to load.
        implicit_usings: Whether to generate the .NET SDK's implicit `global using` directives.
        global_usings: Additional namespaces to emit as `global using` directives.
        excluded_global_usings: Namespaces to exclude from the generated `global using` directives.

    Returns:
        The compile and runtime providers, and the static web assets the compile
        generated.
    """
    is_any_analyzer = is_analyzer or is_language_specific_analyzer
    if is_any_analyzer and target_framework != "netstandard2.0":
        fail("Analyzers must have `target_frameworks = [\"netstandard2.0\"]`.")
    if analyzer_runtime_deps and not is_any_analyzer:
        fail("{}: `analyzer_runtime_deps` is only for an analyzer or source generator. List these in `deps`.".format(label))

    frameworks = applicable_frameworks(target_framework, frameworks)
    check_windows_frameworks(label, target_framework, frameworks)

    assembly_name = target_name if out == "" else out
    out_dir = target_name + "/" + target_framework

    # What the compile references.
    compile_deps = deps + analyzer_runtime_deps
    if include_host_model_dll:
        compile_deps.append(toolchain.host_model)
    if include_msbuild_dlls:
        compile_deps.extend(toolchain.msbuild_dlls)

    (
        irefs,
        prefs,
        analyzers,
        analyzers_csharp,
        analyzers_fsharp,
        analyzers_vb,
        transitive_compile_data,
        framework_files,
        exports_files,
        transitive_internals,
    ) = collect_compile_info(
        assembly_name,
        compile_deps,
        targeting_pack,
        exports,
        strict_deps,
    )

    # The analyzers and source generators that run.
    analyzer_inputs = _analyzer_inputs(
        toolchain = toolchain,
        target_framework = target_framework,
        project_sdk = project_sdk,
        analyzers = analyzers,
        analyzers_csharp = analyzers_csharp,
        analyzer_configs = analyzer_configs,
        run_analyzers = run_analyzers,
        enable_net_analyzers = enable_net_analyzers,
        enforce_code_style_in_build = enforce_code_style_in_build,
        analysis_mode = analysis_mode,
        excluded_analyzers = excluded_analyzers,
        publish_trimmed = publish_trimmed,
        enable_request_delegate_generator = enable_request_delegate_generator,
        enable_configuration_binding_generator = enable_configuration_binding_generator,
        interceptors_namespaces = interceptors_namespaces,
    )

    # The sources. `.razor` and `.cshtml` are inputs to a source generator, not
    # to the compiler, so they travel as additional files rather than sources.
    partitioned = partition_srcs(srcs, label)
    scoped_css = _scoped_css(
        actions,
        label = label,
        partitioned = partitioned,
        deps = deps,
        out_dir = out_dir,
        assembly_name = assembly_name,
        is_application = target != "library",
        scoped_css_tool = scoped_css_tool,
        toolchain = toolchain,
    )
    razor = _razor(
        actions,
        label = label,
        partitioned = partitioned,
        scoped_css = scoped_css,
        out_dir = out_dir,
        root_namespace = root_namespace or target_name,
        target_framework = target_framework,
        project_sdk = project_sdk,
        toolchain = toolchain,
    )

    srcs = partitioned.compile
    global_usings_cs = write_global_usings_csharp(
        actions,
        label = label,
        toolchain = toolchain,
        out_dir = out_dir,
        assembly_name = assembly_name,
        langversion = langversion,
        project_sdk = project_sdk,
        target_framework = target_framework,
        frameworks = frameworks,
        implicit_usings = implicit_usings,
        global_usings = global_usings,
        excluded_global_usings = excluded_global_usings,
    )
    if global_usings_cs:
        srcs = srcs + [global_usings_cs]

    if razor:
        srcs = srcs + razor.srcs

        # csc only counts the sources it is handed, so a target whose code is
        # all Razor would warn that it has none.
        if not srcs:
            nowarn = nowarn + ["CS2008"]

    assembly_info_cs = _write_assembly_info_csharp(actions, target_name, assembly_name, version, user_secrets_id, target_platform(target_framework))
    if assembly_info_cs:
        srcs = srcs + [assembly_info_cs]

    # The outputs, and the files staged beside them. A .NET Framework
    # executable is an `.exe`; .NET runs every assembly from a `.dll`.
    out_ext = "dll" if (target == "library" or is_core_framework(target_framework)) else "exe"
    out_dll = actions.declare_file("%s/%s.%s" % (out_dir, assembly_name, out_ext))
    out_iref = None
    out_ref = actions.declare_file("%s/ref/%s.%s" % (out_dir, assembly_name, out_ext))
    out_pdb = actions.declare_file("%s/%s.pdb" % (out_dir, assembly_name))
    out_xml = actions.declare_file("%s/%s.xml" % (out_dir, assembly_name)) if generate_documentation_file else None

    # A `.resx` is compiled and embedded; a culture's goes into a satellite
    # assembly instead.
    (resx_neutral_resources, satellite_assemblies) = resx_compile(
        actions,
        label = label,
        resx = resx,
        out_dir = out_dir,
        assembly_name = assembly_name,
        toolchain = toolchain,
        compiler_wrapper = compiler_wrapper,
        references = depset(transitive = [irefs, framework_files]),
        framework_files = framework_files,
        keyfile = keyfile,
        version = version,
    )

    out_appsetting_files = copy_appsettings_to_dir(target_name, actions, is_windows, appsetting_files, out_dir)
    out_content_files = copy_content_to_dir(target_name, actions, is_windows, content_file_mappings, out_dir)

    # The compiles.
    compilation = struct(
        actions = actions,
        compiler_wrapper = compiler_wrapper,
        compiler_worker = compiler_worker,
        toolchain = toolchain,
        label = label,
        target_name = target_name,
        target = target,
        target_framework = target_framework,
        # Every compile names the resources after the assembly, even the
        # `/refonly` one, or two resources sharing a file name collide there.
        dll_basename = out_dll.basename,
        allow_unsafe_blocks = allow_unsafe_blocks,
        nullable = nullable,
        treat_warnings_as_errors = treat_warnings_as_errors,
        warnings_as_errors = warnings_as_errors,
        warnings_not_as_errors = warnings_not_as_errors,
        warning_level = warning_level,
        nowarn = nowarn,
        langversion = langversion,
        debug = debug,
        embed_sources = embed_sources,
        refs = irefs,
        framework_files = framework_files,
        razor = razor,
        run_analyzers = run_analyzers,
        analyzers = analyzer_inputs.analyzers,
        additionalfiles = additionalfiles,
        resources = resources,
        resx_neutral_resources = resx_neutral_resources,
        defines = framework_preprocessor_symbols(target_framework) + defines,
        keyfile = keyfile,
        compiler_options = compiler_options,
        interceptors_namespaces = analyzer_inputs.interceptors_namespaces,
        compile_data = depset(compile_data, transitive = [transitive_compile_data]),
    )

    xaml = _xaml(
        compilation,
        partitioned = partitioned,
        srcs = srcs,
        analyzer_inputs = analyzer_inputs,
        frameworks = frameworks,
        wpf_resources = wpf_resources,
        out_dir = out_dir,
        assembly_name = assembly_name,
        root_namespace = root_namespace or target_name,
        tool = xaml_tool,
    )

    if internals_visible_to and not is_analyzer:
        # The friends compile against a reference assembly that keeps the
        # internals, and everyone else against one from a second, `/refonly`
        # compile without the `InternalsVisibleTo` attributes.
        out_iref = actions.declare_file("%s/iref/%s.%s" % (out_dir, assembly_name, out_ext))
        internals_visible_to_cs = _write_internals_visible_to_csharp(
            actions,
            label_name = target_name,
            dll_name = assembly_name,
            others = internals_visible_to,
        )

        _compile(
            compilation,
            srcs = srcs + [internals_visible_to_cs],
            analyzers_csharp = analyzer_inputs.analyzers_csharp,
            analyzer_configs = analyzer_inputs.analyzer_configs,
            out_dll = out_dll,
            out_ref = out_iref,
            out_pdb = out_pdb,
            out_xml = out_xml,
            xaml = xaml,
        )
        _compile(
            compilation,
            srcs = srcs,
            analyzers_csharp = analyzer_inputs.ref_only_analyzers_csharp,
            analyzer_configs = analyzer_inputs.ref_only_analyzer_configs,
            out_dll = None,
            out_ref = out_ref,
            xaml = xaml,
        )
    else:
        _compile(
            compilation,
            srcs = srcs,
            analyzers_csharp = analyzer_inputs.analyzers_csharp,
            analyzer_configs = analyzer_inputs.analyzer_configs,
            out_dll = out_dll,
            out_ref = out_ref,
            out_pdb = out_pdb,
            out_xml = out_xml,
            xaml = xaml,
        )

    # The providers.
    # TODO: Ensure that all the analyzer DLLs also target netstandard2.0.
    analyzer_assemblies = [out_dll] + _collect_analyzer_dependencies(compile_deps, analyzer_runtime_deps) if is_any_analyzer else []

    generated_web_assets = []
    if scoped_css:
        generated_web_assets.append(struct(
            file = scoped_css.bundle,
            subpath = scoped_css.bundle.basename,
            scoped_css_bundle = True,
        ))

    return (DotnetAssemblyCompileInfo(
        name = assembly_name,
        version = version or DEFAULT_ASSEMBLY_VERSION,
        project_sdk = project_sdk,
        target_framework = target_framework,
        refs = [out_ref] if not is_analyzer else [],
        irefs = [out_iref] if out_iref else [out_ref],
        analyzers = analyzer_assemblies if is_analyzer and not is_language_specific_analyzer else [],
        analyzers_csharp = analyzer_assemblies if is_language_specific_analyzer else [],
        analyzers_fsharp = [],
        analyzers_vb = [],
        internals_visible_to = internals_visible_to or [],
        compile_data = compile_data,
        exports = exports_files,
        transitive_refs = prefs if not is_any_analyzer else depset(),
        transitive_internals = transitive_internals if not is_any_analyzer else depset(),
        transitive_analyzers = analyzers,
        transitive_analyzers_csharp = analyzers_csharp,
        transitive_analyzers_fsharp = analyzers_fsharp,
        transitive_analyzers_vb = analyzers_vb,
        transitive_compile_data = transitive_compile_data,
    ), DotnetAssemblyRuntimeInfo(
        name = assembly_name,
        version = version or DEFAULT_ASSEMBLY_VERSION,
        libs = [out_dll] if not is_any_analyzer else [],
        resource_assemblies = satellite_assemblies,
        pdbs = [out_pdb],
        xml_docs = [out_xml] if out_xml else [],
        data = data,
        appsetting_files = depset(out_appsetting_files),
        content_files = out_content_files,
        native = [],
        # `compile_deps` rather than `deps`: an assembly pulled in from the
        # toolchain has to be resolvable at run time too, which is what puts it
        # in deps.json.
        deps = depset(
            [dep[DotnetAssemblyRuntimeInfo] for dep in compile_deps if not _runs_only_in_the_compiler(dep)],
            transitive = [dep[DotnetAssemblyRuntimeInfo].deps for dep in deps],
        ) if not is_any_analyzer else depset(),
        nuget_info = None,
        framework_references = framework_references_of(frameworks),
        direct_deps_depsjson_fragment = {
            dep[DotnetAssemblyRuntimeInfo].name: dep[DotnetAssemblyRuntimeInfo].version
            for dep in deps
            if not _runs_only_in_the_compiler(dep)
        },
    ), generated_web_assets)

def _xaml(compilation, *, partitioned, srcs, analyzer_inputs, frameworks, wpf_resources, out_dir, assembly_name, root_namespace, tool):
    """Compiles WPF XAML as Microsoft.WinFX.targets does. See xaml.bzl.

    Args:
        compilation: The settings every compile of the target shares, from `AssemblyAction`.
        partitioned: The target's sources, from `partition_srcs`.
        srcs: The .cs files the target compiles.
        analyzer_inputs: The analyzers, from `_analyzer_inputs`.
        frameworks: The shared frameworks the target references.
        wpf_resources: Files embedded in `<assembly name>.g.resources`.
        out_dir: The directory the target's outputs go in.
        assembly_name: The assembly name.
        root_namespace: The root namespace.
        tool: The tool that compiles XAML.

    Returns:
        None without XAML or `wpf_resources`, else a struct of the generated
        `code` and the `resources` the assembly embeds.
    """
    c = compilation

    if not partitioned.xaml:
        if not wpf_resources:
            return None

        # The resources are embedded even without XAML.
        check_wpf_resources(c.label, frameworks, c.target_framework)
        return xaml_pass2(
            c.actions,
            c.label,
            None,
            None,
            None,
            wpf_resources,
            out_dir = out_dir,
            assembly_name = assembly_name,
            root_namespace = root_namespace,
            target = c.target,
            references = depset(),
            tool = tool,
            toolchain = c.toolchain,
        )

    plan = xaml_plan(c.label, partitioned.xaml, frameworks, c.target_framework)
    references = depset(transitive = [c.refs, c.framework_files])
    pass1 = xaml_pass1(
        c.actions,
        c.label,
        plan,
        srcs,
        out_dir = out_dir,
        assembly_name = assembly_name,
        root_namespace = root_namespace,
        target = c.target,
        defines = c.defines,
        references = references,
        tool = tool,
        toolchain = c.toolchain,
    )

    # Like GenerateTemporaryTargetAssembly: the sources and pass 1's code, for
    # pass 2 to resolve the types the XAML names against.
    temporary_dir = "{}/xaml/temporary".format(out_dir)
    temporary = c.actions.declare_file("{}/{}.dll".format(temporary_dir, assembly_name))
    _compile(
        _temporary_compilation(c),
        srcs = srcs,
        # As in the ref-only compile: no diagnostics, so no SDK analyzers, but
        # source generators still run.
        analyzers_csharp = analyzer_inputs.ref_only_analyzers_csharp,
        analyzer_configs = analyzer_inputs.ref_only_analyzer_configs,
        out_dll = temporary,
        out_ref = c.actions.declare_file("{}/ref/{}.dll".format(temporary_dir, assembly_name)),
        out_pdb = c.actions.declare_file("{}/{}.pdb".format(temporary_dir, assembly_name)),
        xaml = struct(code = pass1, resources = None),
    )

    return xaml_pass2(
        c.actions,
        c.label,
        plan,
        pass1,
        temporary,
        wpf_resources,
        out_dir = out_dir,
        assembly_name = assembly_name,
        root_namespace = root_namespace,
        target = c.target,
        references = references,
        tool = tool,
        toolchain = c.toolchain,
    )

def _temporary_compilation(compilation):
    """`compilation`, for the temporary assembly that XAML's second pass reads.

    Its diagnostics are the real compile's to report, and nothing ships it.
    """
    return struct(**(structs.to_dict(compilation) | {
        "target_name": compilation.target_name + " (temporary assembly for XAML)",
        "embed_sources": False,
        "treat_warnings_as_errors": False,
        "warnings_as_errors": [],
        "warnings_not_as_errors": [],
        "warning_level": 0,
        "nowarn": [],
        "resx_neutral_resources": [],
    }))

def _compile(compilation, *, srcs, analyzers_csharp, analyzer_configs, out_dll, out_ref, out_pdb = None, out_xml = None, xaml = None):
    """Runs csc once, to `out_dll` and its reference assembly, or with no `out_dll` to a `/refonly` `out_ref`.

    Args:
        compilation: The settings every compile of the target shares, from `AssemblyAction`.
        srcs: The .cs files to compile.
        analyzers_csharp: The C#-specific analyzers to run.
        analyzer_configs: The analyzer config files.
        out_dll: The assembly, or None for a `/refonly` compile.
        out_ref: The reference assembly.
        out_pdb: The symbols, beside `out_dll`.
        out_xml: The XML documentation, or None.
        xaml: What compiling XAML produced, from `_xaml`, or None.
    """
    c = compilation

    # Our goal is to match MSBuild as closely as is reasonable.
    args = c.actions.args()
    args.add("/unsafe+" if c.allow_unsafe_blocks else "/unsafe-")
    args.add("/checked-")
    args.add("/nostdlib+")  # mscorlib comes in with the references.
    args.add("/utf8output")
    args.add("/deterministic+")
    args.add("/filealign:512")
    args.add("/nologo")
    args.add("/highentropyva+" if use_highentropyva(c.target_framework) else "/highentropyva-")
    args.add("/nullable:" + (c.nullable if c.nullable in ("enable", "warnings", "annotations") else "disable"))

    subsystem_version = get_framework_version_info(c.target_framework)
    if subsystem_version != None:
        args.add("/subsystemversion:" + subsystem_version)

    generate_warning_args(
        args,
        c.treat_warnings_as_errors,
        c.warnings_as_errors,
        c.warnings_not_as_errors,
        c.warning_level,
        c.nowarn,
    )

    args.add("/target:" + c.target)
    args.add("/langversion:" + c.langversion)

    if c.debug:
        args.add_all(["/debug+", "/optimize-", "/define:TRACE", "/define:DEBUG"])
    else:
        args.add_all(["/debug-", "/optimize+", "/define:TRACE", "/define:RELEASE"])
    args.add("/debug:portable")

    # A PDB records execroot-relative document paths, which resolve to nothing
    # once the build is over. `/embed` puts the sources in the symbols instead.
    # See docs/README.md#embedded-sources.
    if c.embed_sources:
        args.add("/embed")

    # csc splits each response file line on whitespace, so every path it is
    # handed is quoted.
    if out_dll != None:
        args.add(out_dll, format = "/out:\"%s\"")
        args.add(out_ref, format = "/refout:\"%s\"")
        args.add(out_pdb, format = "/pdb:\"%s\"")
        outputs = [out_dll, out_ref, out_pdb]
    else:
        args.add("/refonly")
        args.add(out_ref, format = "/out:\"%s\"")
        outputs = [out_ref]

    if out_xml != None:
        args.add(out_xml, format = "/doc:\"%s\"")
        outputs.append(out_xml)

    # csc resolves a duplicate assembly identity by order, so refs must come
    # before the framework files.
    format_ref_arg(args, depset(transitive = [c.refs, c.framework_files]), quote = True)

    direct_inputs = srcs + c.resources + [resource_file for (resource_file, _) in c.resx_neutral_resources]
    transitive_inputs = [c.framework_files, c.refs, c.compile_data]

    # A source generator rather than an analyzer, so it runs even when analyzers
    # are switched off: without it every component would be undefined rather
    # than merely undiagnosed.
    if c.razor:
        args.add_all(c.razor.analyzers, format_each = "/analyzer:\"%s\"")
        args.add_all(c.razor.additionalfiles, format_each = "/additionalfile:\"%s\"")
        args.add_all(c.razor.configs, format_each = "/analyzerconfig:\"%s\"")
        direct_inputs += c.razor.analyzers + c.razor.additionalfiles + c.razor.configs

    if c.run_analyzers:
        args.add_all(c.analyzers, format_each = "/analyzer:\"%s\"")
        args.add_all(analyzers_csharp, format_each = "/analyzer:\"%s\"")
        args.add_all(c.additionalfiles, format_each = "/additionalfile:\"%s\"")
        args.add_all(analyzer_configs, format_each = "/analyzerconfig:\"%s\"")
        direct_inputs += c.additionalfiles + analyzer_configs
        transitive_inputs += [c.analyzers, analyzers_csharp]

    args.add_all(srcs, format_each = "\"%s\"")

    # The code generated behind XAML, and `<assembly>.g.resources`, which WPF
    # loads by that name.
    if xaml and xaml.code:
        args.add_all([xaml.code], map_each = generated_code, format_each = "\"%s\"", expand_directories = True)
        direct_inputs.append(xaml.code)
    if xaml and xaml.resources:
        args.add(xaml.resources, format = "/resource:\"%s\",\"" + xaml.resources.basename + "\"")
        direct_inputs.append(xaml.resources)

    add_resource_args(args, c.resources, c.label, c.dll_basename, "csharp")
    add_resx_resource_args(args, c.resx_neutral_resources, language = "csharp")
    args.add_all(c.defines, format_each = "/d:%s")

    if c.keyfile != None:
        args.add(c.keyfile, format = "/keyfile:\"%s\"")
        direct_inputs.append(c.keyfile)

    args.add_all(c.compiler_options)

    if c.interceptors_namespaces:
        args.add("/features:InterceptorsNamespaces=" + ";".join(c.interceptors_namespaces))

    run_compiler(
        c.actions,
        mnemonic = "CSharpCompile",
        progress_message = "Compiling " + c.target_name + (" (internals ref-only dll)" if out_dll == None else ""),
        toolchain = c.toolchain,
        compiler = c.toolchain.csharp_compiler,
        compiler_wrapper = c.compiler_wrapper,
        compiler_worker = c.compiler_worker,
        args = args,
        inputs = depset(direct = direct_inputs, transitive = transitive_inputs),
        outputs = outputs,
    )
