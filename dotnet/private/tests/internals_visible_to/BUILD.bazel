load(
    "//dotnet:defs.bzl",
    "csharp_library",
    "csharp_nunit_test",
    "fsharp_library",
)

# Only here to give `chain` a transitive closure to walk.
csharp_library(
    name = "base",
    srcs = ["Base.cs"],
    target_frameworks = ["net9.0"],
)

csharp_library(
    name = "chain",
    srcs = ["Chain.cs"],
    target_frameworks = ["net9.0"],
    deps = [":base"],
)

csharp_library(
    name = "code_block_analyzer",
    srcs = ["CodeBlockAnalyzer.cs"],
    is_analyzer = True,
    is_language_specific_analyzer = True,
    target_frameworks = ["netstandard2.0"],
    deps = [
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.common",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.csharp",
        "@paket.rules_dotnet_dev_nuget_packages//system.collections.immutable",
        "@paket.rules_dotnet_dev_nuget_packages//system.memory",
    ],
)

csharp_library(
    name = "secrets",
    srcs = ["Secrets.cs"],
    internals_visible_to = [
        "consumer",
        "transitive_consumer",
    ],
    target_frameworks = ["net9.0"],
    deps = [":code_block_analyzer"],
)

# The order of `deps` is what this test is about. See README.md.
csharp_nunit_test(
    name = "consumer",
    srcs = ["Consumer.cs"],
    target_frameworks = ["net9.0"],
    deps = [
        ":chain",
        ":secrets",
    ],
)

# Not named in `internals_visible_to`, so it compiles against the reference
# assembly the `/refonly` compile of `secrets` produces. See README.md.
csharp_nunit_test(
    name = "outsider",
    srcs = ["Outsider.cs"],
    target_frameworks = ["net9.0"],
    deps = [":secrets"],
)

# Only built with strict deps off: strict deps never hand a target the
# dependencies of its dependencies, so these cannot see `secrets` at all
# otherwise. See README.md.
config_setting(
    name = "strict_deps_off",
    flag_values = {"//dotnet/settings:strict_deps": "False"},
)

NON_STRICT_DEPS_ONLY = select({
    ":strict_deps_off": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

csharp_library(
    name = "relay",
    srcs = ["Relay.cs"],
    target_frameworks = ["net9.0"],
    deps = [":secrets"],
)

# Reaches `secrets` only through `relay`. See README.md.
csharp_nunit_test(
    name = "transitive_consumer",
    srcs = ["TransitiveConsumer.cs"],
    target_compatible_with = NON_STRICT_DEPS_ONLY,
    target_frameworks = ["net9.0"],
    deps = [":relay"],
)

# The F# targets are compile-only: what they test is whether fsc accepts the
# access to an internal member. See README.md.
fsharp_library(
    name = "fsharp_secrets",
    srcs = ["FSharpSecrets.fs"],
    internals_visible_to = [
        "fsharp_consumer",
        "fsharp_transitive_consumer",
    ],
    target_frameworks = ["net9.0"],
)

fsharp_library(
    name = "fsharp_relay",
    srcs = ["FSharpRelay.fs"],
    target_frameworks = ["net9.0"],
    deps = [":fsharp_secrets"],
)

# Reaches `fsharp_secrets` directly and, with strict deps off, through
# `fsharp_relay` too. See README.md.
fsharp_library(
    name = "fsharp_consumer",
    srcs = ["FSharpConsumer.fs"],
    target_frameworks = ["net9.0"],
    deps = [
        ":fsharp_relay",
        ":fsharp_secrets",
    ],
)

fsharp_library(
    name = "fsharp_transitive_consumer",
    srcs = ["FSharpConsumer.fs"],
    target_compatible_with = NON_STRICT_DEPS_ONLY,
    target_frameworks = ["net9.0"],
    deps = [":fsharp_relay"],
)
