load(
    "//dotnet:defs.bzl",
    "csharp_library",
    "csharp_nunit_test",
)

# Only here to give `chain` a transitive closure to walk.
csharp_library(
    name = "base",
    srcs = ["Base.cs"],
    target_frameworks = ["net9.0"],
)

csharp_library(
    name = "chain",
    srcs = ["Chain.cs"],
    target_frameworks = ["net9.0"],
    deps = [":base"],
)

csharp_library(
    name = "code_block_analyzer",
    srcs = ["CodeBlockAnalyzer.cs"],
    is_analyzer = True,
    is_language_specific_analyzer = True,
    target_frameworks = ["netstandard2.0"],
    deps = [
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.common",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.csharp",
        "@paket.rules_dotnet_dev_nuget_packages//system.collections.immutable",
        "@paket.rules_dotnet_dev_nuget_packages//system.memory",
    ],
)

csharp_library(
    name = "secrets",
    srcs = ["Secrets.cs"],
    internals_visible_to = ["consumer"],
    target_frameworks = ["net9.0"],
    deps = [":code_block_analyzer"],
)

# The order of `deps` is what this test is about. See README.md.
csharp_nunit_test(
    name = "consumer",
    srcs = ["Consumer.cs"],
    target_frameworks = ["net9.0"],
    deps = [
        ":chain",
        ":secrets",
    ],
)
