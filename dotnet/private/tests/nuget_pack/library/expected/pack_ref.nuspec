  <metadata>
    <id>RulesDotnet.Tests.Lib</id>
    <version>1.2.3-beta.1+abc</version>
    <authors>rules_dotnet</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>The same library, depending on its first-party dependencies as packages.</description>
    <dependencies>
      <group targetFramework="net9.0">
        <dependency id="bundled" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="referenced" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="RulesDotnet.Tests.Deeper" version="4.5.6-nightly.7" exclude="Build,Analyzers" />
        <dependency id="RulesDotnet.Tests.Mapped" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.5.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="bundled" version="1.0.0" exclude="Build,Analyzers" />
        <dependency id="referenced" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="RulesDotnet.Tests.Deeper" version="4.5.6-nightly.7" exclude="Build,Analyzers" />
        <dependency id="RulesDotnet.Tests.Mapped" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.5.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>
