# .NET tool packages, and the tool failures.
#
# NU5128 is expected of all of them: they declare an empty dependency group for
# the framework they run on, and ship nothing under `lib/`.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//dotnet:defs.bzl", "csharp_binary", "fsharp_binary", "import_library", "nuget_pack")
load("//dotnet/private/tests/nuget_pack:nuget_pack_test.bzl", "fails_with_test", "nuget_pack_test")

package(default_visibility = ["//dotnet/private/tests/nuget_pack:__subpackages__"])

csharp_binary(
    name = "tool",
    srcs = ["Tool.cs"],
    target_frameworks = ["net9.0"],
    version = "0.1.0",
    deps = ["//dotnet/private/tests/nuget_pack/library:referenced"],
)

nuget_pack(
    name = "tool_pack",
    authors = ["rules_dotnet"],
    binary = ":tool",
    command_name = "rdtool",
    description = "A .NET tool packed by rules_dotnet's own tests.",
    package_id = "RulesDotnet.Tests.Tool",
    target_frameworks = ["net9.0"],
)

# Its whole closure, with the deps.json and runtimeconfig.json of a publish;
# unpacked, it runs as `dotnet tool` would run it.
nuget_pack_test(
    name = "tool_pack_test",
    contents = {
        "expected/tool_pack.nuspec": "RulesDotnet.Tests.Tool.nuspec",
        "expected/tool_pack.DotnetToolSettings.xml": "tools/net9.0/any/DotnetToolSettings.xml",
        "expected/tool_pack.deps.json": "tools/net9.0/any/tool.deps.json",
        "expected/tool_pack.runtimeconfig.json": "tools/net9.0/any/tool.runtimeconfig.json",
    },
    files = [
        "tools/net9.0/any/DotnetToolSettings.xml",
        "tools/net9.0/any/referenced.dll",
        "tools/net9.0/any/referenced.pdb",
        "tools/net9.0/any/tool.deps.json",
        "tools/net9.0/any/tool.dll",
        "tools/net9.0/any/tool.pdb",
        "tools/net9.0/any/tool.runtimeconfig.json",
    ],
    output = "Hello world from 0.1.0",
    package = ":tool_pack",
    run = ["world"],
    warnings = ["NU5128"],
)

fsharp_binary(
    name = "fs_tool",
    srcs = ["FsTool.fs"],
    target_frameworks = ["net9.0"],
    version = "0.2.0",
    deps = ["@paket.rules_dotnet_dev_nuget_packages//fsharp.core"],
)

