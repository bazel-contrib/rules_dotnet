# --- Every runtime's assets --------------------------------------------------
#
# `dotnet tool install` puts a tool on any operating system, so the package
# carries what `dotnet pack` with `PackAsTool` gives it: every runtime's native
# libraries and assemblies out of the NuGet packages, at their path in the
# package they came from, and a deps.json listing them under `runtimeTargets`
# for the host to pick the ones for the machine it runs on.

csharp_binary(
    name = "rocks_tool",
    srcs = ["RocksTool.cs"],
    target_frameworks = ["net9.0"],
    version = "0.3.0",
    deps = ["@paket.rules_dotnet_dev_nuget_packages//rocksdb"],
)

nuget_pack(
    name = "rocks_tool_pack",
    authors = ["rules_dotnet"],
    binary = ":rocks_tool",
    description = "A .NET tool with native libraries for every runtime, packed by rules_dotnet's own tests.",
    package_id = "RulesDotnet.Tests.RocksTool",
    target_frameworks = ["net9.0"],
)

# RocksDB's natives for all five runtimes it ships, whichever this builds on.
# Not run: RocksDB has nothing for some of the hosts the tests run on, such as
# win-arm64. `git_tool_pack_test` runs a tool that loads its natives.
nuget_pack_test(
    name = "rocks_tool_pack_test",
    contents = {
        "expected/rocks_tool_pack.deps.json": "tools/net9.0/any/rocks_tool.deps.json",
    },
    files = [
        "tools/net9.0/any/DotnetToolSettings.xml",
        "tools/net9.0/any/RocksDbSharp.dll",
        "tools/net9.0/any/rocks_tool.deps.json",
        "tools/net9.0/any/rocks_tool.dll",
        "tools/net9.0/any/rocks_tool.pdb",
        "tools/net9.0/any/rocks_tool.runtimeconfig.json",
        "tools/net9.0/any/runtimes/linux-arm64/native/librocksdb.so",
        "tools/net9.0/any/runtimes/linux-arm64/native/librocksdb-musl.so",
        "tools/net9.0/any/runtimes/linux-x64/native/librocksdb.so",
        "tools/net9.0/any/runtimes/linux-x64/native/librocksdb-jemalloc.so",
        "tools/net9.0/any/runtimes/linux-x64/native/librocksdb-musl.so",
        "tools/net9.0/any/runtimes/osx-arm64/native/librocksdb.dylib",
        "tools/net9.0/any/runtimes/osx-x64/native/librocksdb.dylib",
        "tools/net9.0/any/runtimes/win-x64/native/rocksdb.dll",
    ],
    package = ":rocks_tool_pack",
    warnings = ["NU5128"],
)

