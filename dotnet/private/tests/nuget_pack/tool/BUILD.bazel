        "tools/net9.0/any/DotnetToolSettings.xml",
        "tools/net9.0/any/FSharp.Core.dll",
        "tools/net9.0/any/cs/FSharp.Core.resources.dll",
        "tools/net9.0/any/de/FSharp.Core.resources.dll",
        "tools/net9.0/any/es/FSharp.Core.resources.dll",
        "tools/net9.0/any/fr/FSharp.Core.resources.dll",
        "tools/net9.0/any/fs_tool.deps.json",
        "tools/net9.0/any/fs_tool.dll",
        "tools/net9.0/any/fs_tool.pdb",
        "tools/net9.0/any/fs_tool.runtimeconfig.json",
        "tools/net9.0/any/it/FSharp.Core.resources.dll",
        "tools/net9.0/any/ja/FSharp.Core.resources.dll",
        "tools/net9.0/any/ko/FSharp.Core.resources.dll",
        "tools/net9.0/any/pl/FSharp.Core.resources.dll",
        "tools/net9.0/any/pt-BR/FSharp.Core.resources.dll",
        "tools/net9.0/any/ru/FSharp.Core.resources.dll",
