# --- Failures ----------------------------------------------------------------
#
# The targets under test are `manual`: they exist to fail, and only the tests
# that expect the failure build them.

nuget_pack(
    name = "tool_with_rids",
    authors = ["rules_dotnet"],
    binary = ":tool",
    description = "d",
    runtime_identifiers = ["linux-x64"],
    tags = ["manual"],
    target_frameworks = ["net9.0"],
)

fails_with_test(
    name = "tool_with_rids_test",
    size = "small",
    expected_message_fragments = ["a tool package is not RID-specific"],
    target_under_test = ":tool_with_rids",
)

nuget_pack(
    name = "tool_depending_on_a_package",
    authors = ["rules_dotnet"],
    binary = ":tool",
    description = "d",
    tags = ["manual"],
    target_frameworks = ["net9.0"],
    deps = ["//dotnet/private/tests/nuget_pack/library:mapped_pack"],
)

fails_with_test(
    name = "tool_depending_on_a_package_test",
    size = "small",
    expected_message_fragments = ["a tool package ships its whole closure"],
    target_under_test = ":tool_depending_on_a_package",
)

# A native library built here exists for the runtime being built alone, so a
# tool package, which installs on any, cannot ship it.
cc_library(
    name = "first_party_native_static",
    srcs = ["native.c"],
    tags = ["manual"],
)

cc_shared_library(
    name = "first_party_native",
    tags = ["manual"],
    deps = [":first_party_native_static"],
)

import_library(
    name = "first_party_native_import",
    library_name = "first_party_native",
    native = [":first_party_native"],
    tags = ["manual"],
)

csharp_binary(
    name = "tool_with_first_party_native",
    srcs = ["Tool.cs"],
    tags = ["manual"],
    target_frameworks = ["net9.0"],
    deps = [":first_party_native_import"],
)

nuget_pack(
    name = "tool_with_first_party_native_pack",
    authors = ["rules_dotnet"],
    binary = ":tool_with_first_party_native",
    description = "d",
    tags = ["manual"],
    target_frameworks = ["net9.0"],
)

fails_with_test(
    name = "tool_with_first_party_native_test",
    size = "small",
    expected_message_fragments = [
        "the tool depends on first_party_native, whose native libraries (",
        "//dotnet/private/tests/nuget_pack/tool:first_party_native)",
        "the native libraries it ships have to come out of NuGet packages",
    ],
    target_under_test = ":tool_with_first_party_native_pack",
)
