# --- Determinism -------------------------------------------------------------
#
# Two packages built from the same inputs in different output folders: identical
# bytes mean no path, time or random name got in.

nuget_pack(
    name = "det_a",
    authors = ["rules_dotnet"],
    description = "Determinism check.",
    first_party_deps = "bundle",
    library = ":lib",
    package_id = "RulesDotnet.Tests.Det",
    readme = "README.md",
    symbols = "snupkg",
    target_frameworks = [
        "netstandard2.0",
        "net9.0",
    ],
    deps = [":mapped_pack"],
)

nuget_pack(
    name = "det_b",
    authors = ["rules_dotnet"],
    description = "Determinism check.",
    first_party_deps = "bundle",
    library = ":lib",
    package_id = "RulesDotnet.Tests.Det",
    readme = "README.md",
    symbols = "snupkg",
    target_frameworks = [
        "netstandard2.0",
        "net9.0",
    ],
    deps = [":mapped_pack"],
)

[
    select_file(
        name = "det_{}_{}".format(side, extension),
        srcs = ":det_{}".format(side),
        subpath = "det_{}/RulesDotnet.Tests.Det.1.2.3-beta.1.{}".format(side, extension),
    )
    for side in [
        "a",
        "b",
    ]
    for extension in [
        "nupkg",
        "snupkg",
    ]
]

[
    diff_test(
        name = "deterministic_{}".format(extension),
        file1 = ":det_a_{}".format(extension),
        file2 = ":det_b_{}".format(extension),
    )
    for extension in [
        "nupkg",
        "snupkg",
    ]
]

