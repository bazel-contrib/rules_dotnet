# --- Failures ----------------------------------------------------------------
#
# The targets under test are `manual`: they exist to fail, and only the tests
# that expect the failure build them.

csharp_library(
    name = "bad_version",
    srcs = ["Simple.cs"],
    tags = ["manual"],
    target_frameworks = ["net9.0"],
    version = "1",
)

fails_with_test(
    name = "bad_version_test",
    size = "small",
    expected_message_fragments = ["version \"1\" must have two to four numeric components"],
    target_under_test = ":bad_version",
)

csharp_library(
    name = "net9_only",
    srcs = ["Simple.cs"],
