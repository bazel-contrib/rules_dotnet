# --- An analyzer package -----------------------------------------------------

csharp_library(
    name = "generator_support",
    srcs = ["GeneratorSupport.cs"],
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
)

# A source generator. `is_language_specific_analyzer` is what puts it under
# `analyzers/dotnet/cs`; the Roslyn packages it compiles against stay out of the
# package, and the first-party assembly it loads travels with it.
csharp_library(
    name = "generator",
    srcs = ["Generator.cs"],
    analyzer_configs = [".analyzerconfig"],
    is_analyzer = True,
    is_language_specific_analyzer = True,
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
    deps = [
        ":generator_support",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.analyzers",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.common",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.csharp",
    ],
)

nuget_pack(
    name = "generator_pack",
    authors = ["rules_dotnet"],
    description = "A source generator packed by rules_dotnet's own tests.",
    development_dependency = True,
    library = ":generator",
    package_id = "RulesDotnet.Tests.Generator",
    symbols = "embedded",
    target_frameworks = ["netstandard2.0"],
)

# --- A Razor class library package -------------------------------------------

# `out` names the assembly after the package: the library serves its files under
# `_content/<assembly name>` in this build and under `_content/<package id>` out
# of the package, so the two have to agree.
csharp_library(
    name = "components",
    srcs = [
        "Widget.razor",
        "Widget.razor.css",
        "_Imports.razor",
    ],
    out = "RulesDotnet.Tests.Components",
    project_sdk = "razor",
    root_namespace = "RulesDotnet.Tests.Components",
    static_web_assets = glob(["wwwroot/**"]),
    target_frameworks = ["net10.0"],
    version = "1.0.0",
)

nuget_pack(
    name = "components_pack",
    authors = ["rules_dotnet"],
    description = "A Razor class library packed by rules_dotnet's own tests.",
    library = ":components",
    package_id = "RulesDotnet.Tests.Components",
    target_frameworks = ["net10.0"],
)

# --- Tool packages -----------------------------------------------------------

csharp_binary(
    name = "tool",
    srcs = ["Tool.cs"],
    target_frameworks = ["net9.0"],
    version = "0.1.0",
    deps = [":referenced"],
)

nuget_pack(
    name = "tool_pack",
    authors = ["rules_dotnet"],
    binary = ":tool",
    command_name = "rdtool",
    description = "A .NET tool packed by rules_dotnet's own tests.",
    package_id = "RulesDotnet.Tests.Tool",
    target_frameworks = ["net9.0"],
)

# Round trip: the extracted package is what `dotnet_tool` runs.
extract_nupkg(
    name = "tool_extracted",
    entries = [
        "tools/net9.0/any/DotnetToolSettings.xml",
        "tools/net9.0/any/tool.dll",
        "tools/net9.0/any/tool.deps.json",
        "tools/net9.0/any/tool.runtimeconfig.json",
        "tools/net9.0/any/referenced.dll",
    ],
    nupkg = ":tool_pack",
)

tool_files(
    name = "tool_files",
    files = ":tool_extracted",
    tfm = "net9.0",
)

dotnet_tool(
    name = "rdtool",
    entrypoint = {"net9.0": "tool.dll"},
    runner = {"net9.0": "dotnet"},
    target_frameworks = ["net9.0"],
    deps = ":tool_files",
)

genrule(
    name = "rdtool_output",
    outs = ["rdtool_actual.txt"],
    cmd = "$(location :rdtool) world > $@",
    tools = [":rdtool"],
)

assert_contains(
    name = "rdtool_runs",
    actual = ":rdtool_output",
    expected = "Hello world from 0.1.0",
)

