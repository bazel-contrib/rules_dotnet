<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RulesDotnet.Tests.FsLib</id>
    <version>2.0.0</version>
    <authors>rules_dotnet</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>An F# library packed by rules_dotnet's own tests.</description>
    <dependencies>
      <group targetFramework="net9.0">
        <dependency id="FSharp.Core" version="10.1.401" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="FSharp.Core" version="10.1.401" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>
