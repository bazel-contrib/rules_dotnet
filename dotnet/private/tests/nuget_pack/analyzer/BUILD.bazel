# Analyzer packages, and the analyzer failures.
#
# NU5128 is expected of both: they declare an empty dependency group for a
# framework they ship nothing under `lib/` for.

load("//dotnet:defs.bzl", "csharp_library", "nuget_pack")
load("//dotnet/private/tests/nuget_pack:nuget_pack_test.bzl", "fails_with_test", "nuget_pack_test")

package(default_visibility = ["//dotnet/private/tests/nuget_pack:__subpackages__"])

csharp_library(
    name = "generator_support",
    srcs = ["GeneratorSupport.cs"],
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
)

# A source generator. `is_language_specific_analyzer` is what puts it under
# `analyzers/dotnet/cs`; the Roslyn packages it compiles against stay out of the
# package, and the first-party assembly it loads travels with it.
csharp_library(
    name = "generator",
    srcs = ["Generator.cs"],
    analyzer_configs = [".analyzerconfig"],
    is_analyzer = True,
    is_language_specific_analyzer = True,
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
    deps = [
        ":generator_support",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.analyzers",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.common",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.csharp",
    ],
)

nuget_pack(
    name = "generator_pack",
    authors = ["rules_dotnet"],
    description = "A source generator packed by rules_dotnet's own tests.",
    development_dependency = True,
    library = ":generator",
    package_id = "RulesDotnet.Tests.Generator",
    symbols = "embedded",
    target_frameworks = ["netstandard2.0"],
)

nuget_pack_test(
    name = "generator_pack_test",
    contents = {
        "expected/generator_pack.nuspec": "RulesDotnet.Tests.Generator.nuspec",
    },
    files = [
        "analyzers/dotnet/cs/generator.dll",
        "analyzers/dotnet/cs/generator.pdb",
        "analyzers/dotnet/cs/generator_support.dll",
    ],
    package = ":generator_pack",
    warnings = ["NU5128"],
)

# The same generator for any language: under `analyzers/dotnet`, with its pdb
# in the symbol package.
csharp_library(
    name = "analyzer",
    srcs = ["Generator.cs"],
    analyzer_configs = [".analyzerconfig"],
    is_analyzer = True,
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
    deps = [
        ":generator_support",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.analyzers",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.common",
        "@paket.rules_dotnet_dev_nuget_packages//microsoft.codeanalysis.csharp",
    ],
)

nuget_pack(
    name = "analyzer_pack",
    authors = ["rules_dotnet"],
    description = "An analyzer for any language packed by rules_dotnet's own tests.",
    development_dependency = True,
    library = ":analyzer",
    package_id = "RulesDotnet.Tests.Analyzer",
    symbols = "snupkg",
    target_frameworks = ["netstandard2.0"],
)

nuget_pack_test(
    name = "analyzer_pack_test",
    contents = {
        "expected/analyzer_pack.nuspec": "RulesDotnet.Tests.Analyzer.nuspec",
    },
    files = [
        "analyzers/dotnet/analyzer.dll",
        "analyzers/dotnet/generator_support.dll",
    ],
    package = ":analyzer_pack",
    symbol_files = ["analyzers/dotnet/analyzer.pdb"],
    warnings = ["NU5128"],
)

# A source generator that loads a NuGet package the compiler does not bring
# ships it beside itself, as an analyzer package built by MSBuild does. Roslyn,
# which it also compiles against, stays out.
nuget_pack(
    name = "humanizing_generator_pack",
    authors = ["rules_dotnet"],
    description = "A source generator with a runtime dependency, packed by rules_dotnet's own tests.",
    development_dependency = True,
    library = "//dotnet/private/tests/analyzer_dependencies:humanizing_generator",
    package_id = "RulesDotnet.Tests.HumanizingGenerator",
    target_frameworks = ["netstandard2.0"],
)

nuget_pack_test(
    name = "humanizing_generator_pack_test",
    contents = {
        "expected/humanizing_generator_pack.nuspec": "RulesDotnet.Tests.HumanizingGenerator.nuspec",
    },
    files = [
        "analyzers/dotnet/cs/Humanizer.dll",
        "analyzers/dotnet/cs/humanizing_generator.dll",
    ],
    package = ":humanizing_generator_pack",
    warnings = ["NU5128"],
)

# A library compiled with a first-party generator it does not ship: the generator
# ran in the compiler and is no part of the library's runtime graph, so the
# package neither declares nor bundles it, whatever `first_party_deps` says.

csharp_library(
    name = "generated",
    srcs = ["Generated.cs"],
    target_frameworks = ["netstandard2.0"],
    version = "1.0.0",
    deps = [":generator"],
)

[
    nuget_pack(
        name = "generated_" + first_party_deps,
        authors = ["rules_dotnet"],
        description = "A library compiled with a source generator it does not ship.",
        first_party_deps = first_party_deps,
        library = ":generated",
        package_id = "RulesDotnet.Tests.Generated",
        target_frameworks = ["netstandard2.0"],
    )
    for first_party_deps in [
        "reference",
        "bundle",
        "error",
    ]
]

[
    nuget_pack_test(
        name = "generated_{}_test".format(first_party_deps),
        contents = {
            "expected/generated.nuspec": "RulesDotnet.Tests.Generated.nuspec",
        },
        files = [
            "lib/netstandard2.0/generated.dll",
            "lib/netstandard2.0/generated.xml",
            "ref/netstandard2.0/generated.dll",
        ],
        package = ":generated_" + first_party_deps,
        # As for every package with a `ref/` folder.
        warnings = ["NU5131"],
    )
    for first_party_deps in [
        "reference",
        "bundle",
        "error",
    ]
]

# The same library, for consumers that should run the generator too: its
# package is listed in `deps`, so it is declared like any other package there.
nuget_pack(
    name = "generated_with_generator",
    authors = ["rules_dotnet"],
    description = "A library whose consumers run the source generator it was compiled with.",
    library = ":generated",
    package_id = "RulesDotnet.Tests.GeneratedWithGenerator",
    target_frameworks = ["netstandard2.0"],
    deps = [":generator_pack"],
)

nuget_pack_test(
    name = "generated_with_generator_test",
    contents = {
        "expected/generated_with_generator.nuspec": "RulesDotnet.Tests.GeneratedWithGenerator.nuspec",
    },
    files = [
        "lib/netstandard2.0/generated.dll",
        "lib/netstandard2.0/generated.xml",
        "ref/netstandard2.0/generated.dll",
    ],
    package = ":generated_with_generator",
    warnings = ["NU5131"],
)

# --- Failures ----------------------------------------------------------------

nuget_pack(
    name = "analyzer_with_rids",
    authors = ["rules_dotnet"],
    description = "d",
    library = ":generator",
    runtime_identifiers = ["linux-x64"],
    tags = ["manual"],
    target_frameworks = ["netstandard2.0"],
)

fails_with_test(
    name = "analyzer_with_rids_test",
    size = "small",
    expected_message_fragments = ["an analyzer runs inside the compiler, not on a runtime"],
    target_under_test = ":analyzer_with_rids",
)
