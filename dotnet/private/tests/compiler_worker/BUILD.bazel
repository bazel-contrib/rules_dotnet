load("//dotnet:defs.bzl", "csharp_nunit_test")

# The compiles link resolution matters for need a build server that outlives a
# worker directory, so only this exercises it.
csharp_nunit_test(
    name = "resolve_input_links",
    size = "small",
    srcs = [
        "ResolveInputLinksTest.cs",
        "//dotnet/private/tools/worker:srcs",
    ],
    target_frameworks = ["net10.0"],
)

csharp_nunit_test(
    name = "run_once",
    size = "small",
    srcs = [
        "RunOnceTest.cs",
        "//dotnet/private/tools/worker:srcs",
    ],
    target_frameworks = ["net10.0"],
)

csharp_nunit_test(
    name = "worker_loop",
    size = "small",
    srcs = [
        "WorkerLoopTest.cs",
        "//dotnet/private/tools/worker:srcs",
    ],
    target_frameworks = ["net10.0"],
)

# Runs the compiler workers themselves, with the toolchain's compilers.
csharp_nunit_test(
    name = "compiler_workers",
    size = "medium",
    srcs = ["CompilerWorkersTest.cs"],
    data = [
        "//dotnet:resolved_toolchain",
        "//dotnet/private/tools/csharp_compiler_worker",
        "//dotnet/private/tools/fsharp_compiler_worker",
    ],
    envs = {
        "CSC_BIN": "$(CSC_BIN)",
        "CSHARP_COMPILER_WORKER": "$(rlocationpaths //dotnet/private/tools/csharp_compiler_worker)",
        "DOTNET_BIN": "$(DOTNET_BIN)",
        "FSC_BIN": "$(FSC_BIN)",
        "FSHARP_COMPILER_WORKER": "$(rlocationpaths //dotnet/private/tools/fsharp_compiler_worker)",
    },
    target_frameworks = ["net10.0"],
    toolchains = ["//dotnet:resolved_toolchain"],
    deps = ["//tools/runfiles"],
)
