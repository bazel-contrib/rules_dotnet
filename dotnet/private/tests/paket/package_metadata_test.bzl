    "net11": [],
    "net20": [],
    "net30": [],
    "net35": ["NUnit"],
    "net40": ["NUnit"],
    "net403": ["NUnit"],
    "net45": ["NUnit"],
    "net451": ["NUnit"],
    "net452": ["NUnit"],
    "net46": ["NUnit"],
    "net461": ["NUnit"],
    "net462": ["NUnit"],
    "net47": ["NUnit"],
    "net471": ["NUnit"],
    "net472": ["NUnit"],
    "net48": ["NUnit"],
    "net481": ["NUnit"],
    "net5.0": ["NUnit"],
    "net6.0": ["NUnit"],
    "net7.0": ["NUnit"],
    "net8.0": ["NUnit"],
    "net9.0": ["NUnit"],
    "netcoreapp1.0": [],
    "netcoreapp1.1": [],
    "netcoreapp2.0": ["NUnit", "NETStandard.Library"],
    "netcoreapp2.1": ["NUnit", "NETStandard.Library"],
    "netcoreapp2.2": ["NUnit", "NETStandard.Library"],
    "netcoreapp3.0": ["NUnit", "NETStandard.Library"],
