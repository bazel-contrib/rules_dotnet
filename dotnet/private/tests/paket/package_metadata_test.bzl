_FRAMEWORK_LIST = """\
<FileList TargetFrameworkIdentifier=".NETCoreApp" FrameworkName="Microsoft.NETCore.App">
  <File Type="Analyzer" Path="analyzers/dotnet/cs/Gen.dll" AssemblyName="Gen" AssemblyVersion="6.0.6.21309" />
  <File Type="Managed" Path="ref/net6.0/Microsoft.CSharp.dll" AssemblyName="Microsoft.CSharp" AssemblyVersion="6.0.0.0" />
