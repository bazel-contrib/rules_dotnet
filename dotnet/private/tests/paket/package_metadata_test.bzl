def _xml_test_impl(ctx):
    env = unittest.begin(ctx)
    package = xml.parse(_NUSPEC)
    metadata = xml.child(package, "metadata")

    asserts.equals(env, "package", xml.local_name(package))
    asserts.equals(env, "2.12", xml.attr(metadata, "minClientVersion"))
    asserts.equals(env, "", xml.attr(metadata, "nope"))
    asserts.equals(
        env,
        5,
        len(xml.children(xml.child(metadata, "dependencies"), "group")),
        "elements inside a comment or a CDATA section are not elements",
    )

    return unittest.end(env)

_xml_test = unittest.make(_xml_test_impl)

def _parse_nuspec_test_impl(ctx):
    env = unittest.begin(ctx)
    nuspec = parse_nuspec(_NUSPEC)

    asserts.false(env, nuspec.is_dotnet_tool)
    asserts.equals(
        env,
        {
            "net35": ["NUnit"],
            "net7.0": ["NUnit"],
            "netcoreapp3.1": ["NUnit"],
            "netstandard2.0": ["NUnit", "NETStandard.Library"],
        },
        nuspec.dependency_groups,
        "groups for unsupported frameworks are dropped",
    )

    asserts.true(env, parse_nuspec(_TOOL_NUSPEC).is_dotnet_tool)
    asserts.equals(
        env,
        {"": ["NUnit"]},
        parse_nuspec(_LEGACY_NUSPEC).dependency_groups,
        "dependencies outside a group apply to every framework",
    )

    return unittest.end(env)

_parse_nuspec_test = unittest.make(_parse_nuspec_test_impl)

def _selected(env, deps, tfm):
    """What a select over `deps` gives a configuration for `tfm`, as Bazel picks it.

    A `tfm_*` condition holds where every framework it is compatible with is,
    and of the conditions that hold, the one whose frameworks include all the
    others' wins. Any other outcome is an ambiguous select, which fails.
    """
    compatible = TRANSITIVE_FRAMEWORK_COMPATIBILITY[tfm]
    holding = [
        condition.split(":tfm_")[1]
        for condition in deps
        if ":tfm_" in condition and sets.is_subset(TRANSITIVE_FRAMEWORK_COMPATIBILITY[condition.split(":tfm_")[1]], compatible)
    ]
    if not holding:
        return deps["//conditions:default"]

    winners = [
        framework
        for framework in holding
        if all([sets.is_subset(TRANSITIVE_FRAMEWORK_COMPATIBILITY[other], TRANSITIVE_FRAMEWORK_COMPATIBILITY[framework]) for other in holding])
    ]
    asserts.equals(env, 1, len(winners), "one branch wins for {} among {}".format(tfm, holding))

    return deps["@rules_dotnet//dotnet:tfm_{}".format(winners[0])]

def _deps_by_tfm_test_impl(ctx):
    env = unittest.begin(ctx)
    packages = {"netstandard.library": "netstandard.library", "nunit": "nunit"}

    actual = deps_by_tfm(parse_nuspec(_NUSPEC).dependency_groups, packages)

    # Every framework gets what its nearest group says, though most have no
    # branch of their own.
    for (tfm, ids) in _NUNITLITE_DEPS.items():
        asserts.equals(env, ["//{}".format(id.lower()) for id in ids], _selected(env, actual, tfm), tfm)

    asserts.equals(
        env,
        sorted([
            # The first of a family, and those bridging to .NET Standard.
            "net11",
            "net451",
            "net46",
            "net461",
            "netcoreapp2.0",
            "netcoreapp3.0",
            "netstandard",
            # Where the nearest group changes.
            "net35",
            "net45",
            "netcoreapp3.1",
            "netstandard2.0",
        ]),
        sorted([condition.split(":tfm_")[1] for condition in actual if ":tfm_" in condition]),
        "the frameworks that resolve unlike their only predecessor",
    )

    # Groups that change along the line, and frameworks that resolve to
    # nothing in between, keep their branches.
    shifting = deps_by_tfm(
        {
            "net462": [],
            "net6.0": ["A"],
            "net8.0": ["A", "B"],
            "netstandard2.0": ["C"],
        },
        {"a": "a", "b": "b", "c": "c"},
    )
    for tfm in FRAMEWORK_COMPATIBILITY:
        nearest = get_nearest_compatible_target_framework(tfm, ["net462", "net6.0", "net8.0", "netstandard2.0"])
        expected = {None: [], "net462": [], "net6.0": ["//a"], "net8.0": ["//a", "//b"], "netstandard2.0": ["//c"]}[nearest]
        asserts.equals(env, expected, _selected(env, shifting, tfm), tfm)

    asserts.equals(
        env,
        {},
        {
            condition: labels
            for (condition, labels) in deps_by_tfm(
                parse_nuspec(_NUSPEC).dependency_groups,
                {},
            ).items()
            if labels
        },
        "dependencies that the group did not resolve are dropped",
    )

    return unittest.end(env)

_deps_by_tfm_test = unittest.make(_deps_by_tfm_test_impl)

def _framework_test_impl(ctx):
    env = unittest.begin(ctx)

    for (framework, expected) in _TFMS.items():
        asserts.equals(env, expected, nuget_framework_to_tfm(framework), framework)

    asserts.equals(
        env,
        "net45",
        get_nearest_compatible_target_framework("net48", ["netstandard2.0", "net45"]),
        "a framework of the same family wins over a compatible one",
    )
    asserts.equals(
        env,
        "netstandard2.0",
        get_nearest_compatible_target_framework("net10.0", ["netstandard2.0", "net48"]),
        ".NET Framework is not compatible with .NET",
    )
    asserts.equals(
        env,
        None,
        get_nearest_compatible_target_framework("net20", ["netstandard2.0"]),
    )

    return unittest.end(env)

_framework_test = unittest.make(_framework_test_impl)

def _package_files_test_impl(ctx):
    env = unittest.begin(ctx)

    asserts.equals(
        env,
        {"microsoft.csharp": "6.0.0.0", "system.xml": "4.0.0.0"},
        parse_framework_list(_FRAMEWORK_LIST),
        "only managed assemblies are part of the framework list",
    )
    asserts.equals(
        env,
        {"microsoft.csharp": "4.4.0", "microsoft.win32.primitives": "4.3.0"},
        parse_package_overrides(_PACKAGE_OVERRIDES),
    )
    asserts.equals(
        env,
        [{"entrypoint": "CSharpier.dll", "name": "csharpier", "runner": "dotnet"}],
        parse_dotnet_tool_settings(_TOOL_SETTINGS, "DotnetToolSettings.xml"),
    )

    return unittest.end(env)

_package_files_test = unittest.make(_package_files_test_impl)

def package_metadata_test_suite(name):
    unittest.suite(
        name,
        _deps_by_tfm_test,
        _framework_test,
        _package_files_test,
        _parse_nuspec_test,
        _xml_test,
    )
