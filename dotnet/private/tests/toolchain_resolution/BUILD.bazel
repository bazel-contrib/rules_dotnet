"""These tests are for asserting that the dotnet toolchain can be resolved and used using template variables.
"""

load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:testing.bzl", "assert_contains")

genrule(
    name = "dotnet_bin",
    outs = ["dotnet_bin.txt"],
    cmd = "DOTNET_CLI_HOME=\"$$(pwd)/$$(dirname $(DOTNET_BIN))\" \"$(DOTNET_BIN)\" --help > $@",
    toolchains = [
        "//dotnet:resolved_toolchain",
    ],
    tools = [
        "//dotnet:resolved_toolchain",
    ],
)

assert_contains(
    name = "check_dotnet_bin_output",
    actual = ":dotnet_bin",
    expected = "Usage: dotnet [runtime-options] [path-to-application] [arguments]",
)

genrule(
    name = "csc_bin",
    outs = ["csc_bin.txt"],
    cmd = "DOTNET_CLI_HOME=\"$$(pwd)/$$(dirname $(DOTNET_BIN))\" \"$(DOTNET_BIN)\" \"$(CSC_BIN)\" -help > $@",
    toolchains = [
        "//dotnet:resolved_toolchain",
    ],
    tools = [
        "//dotnet:resolved_toolchain",
    ],
)

assert_contains(
    name = "check_csc_bin_output",
    actual = ":csc_bin",
    expected = "Microsoft (R) Visual C# Compiler",
)

genrule(
    name = "fsc_bin",
    outs = ["fsc_bin.txt"],
    cmd = "DOTNET_CLI_HOME=\"$$(pwd)/$$(dirname $(DOTNET_BIN))\" \"$(DOTNET_BIN)\" \"$(FSC_BIN)\" --help > $@",
    toolchains = [
        "//dotnet:resolved_toolchain",
    ],
    tools = [
        "//dotnet:resolved_toolchain",
    ],
)

assert_contains(
    name = "check_fsc_bin_output",
    actual = ":fsc_bin",
    expected = "Microsoft (R) F# Compiler version",
)

# The versions the toolchain reports, against those the SDK itself does, so
# that they hold for whichever SDK is registered.
_SDK_REPORTS = {
    "sdk_version": "\"$(DOTNET_BIN)\" --version",
    "runtime_version": "\"$(DOTNET_BIN)\" --list-runtimes | grep '^Microsoft.NETCore.App ' | cut -d' ' -f2",
    # The framework the runtime is: net, then its major and minor version.
    "runtime_tfm": "echo net$$(\"$(DOTNET_BIN)\" --list-runtimes | grep '^Microsoft.NETCore.App ' | cut -d' ' -f2 | cut -d. -f1-2)",
}

[
    genrule(
        name = "{}_reported".format(name),
        outs = ["{}_reported.txt".format(name)],
        cmd = "export DOTNET_CLI_HOME=\"$$(pwd)/$$(dirname $(DOTNET_BIN))\"; ({}) | tr -d '\\r' > $@".format(command),
        toolchains = [
            "//dotnet:resolved_toolchain",
        ],
        tools = [
            "//dotnet:resolved_toolchain",
        ],
    )
    for (name, command) in _SDK_REPORTS.items()
]

[
    genrule(
        name = "{}_toolchain".format(name),
        outs = ["{}_toolchain.txt".format(name)],
        cmd = "echo \"$({})\" > $@".format(variable),
        toolchains = [
            "//dotnet:resolved_toolchain",
        ],
    )
    for (name, variable) in {
        "sdk_version": "DOTNET_SDK_VERSION",
        "runtime_version": "DOTNET_RUNTIME_VERSION",
        "runtime_tfm": "DOTNET_RUNTIME_TFM",
    }.items()
]

[
    diff_test(
        name = "check_dotnet_{}".format(name),
        file1 = ":{}_toolchain".format(name),
        file2 = ":{}_reported".format(name),
    )
    for name in _SDK_REPORTS
]

# Registering the toolchains loads the package of their toolchain type. Keep
# that package free of the TFM and RID settings in //dotnet.
genquery(
    name = "toolchain_type_buildfiles",
    expression = "buildfiles(//dotnet/toolchain:all)",
    scope = [
        "//dotnet/toolchain:bootstrap_toolchain_type",
        "//dotnet/toolchain:toolchain_type",
    ],
)

diff_test(
    name = "toolchain_type_buildfiles_test",
    file1 = ":toolchain_type_buildfiles",
    file2 = "toolchain_type_buildfiles.txt",
)
