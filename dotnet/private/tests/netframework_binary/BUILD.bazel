load(
    "//dotnet:defs.bzl",
    "csharp_binary",
    "csharp_library",
    "csharp_nunit_test",
    "csharp_test",
    "fsharp_binary",
    "import_library",
    "publish_binary",
)
load(":netfx_config_inputs_test.bzl", "netfx_config_inputs_test")
load(":publish_runfiles_test.bzl", "publish_runfiles_test")

csharp_binary(
    name = "keygen",
    srcs = ["KeyGen.cs"],
    nullable = "enable",
    target_frameworks = ["net8.0"],
)

genrule(
    name = "generate_snk",
    outs = ["test.snk"],
    cmd = "$(execpath :keygen) $@",
    tools = [":keygen"],
)

# A second key, for a different assembly that is also named SharedDep.
genrule(
    name = "generate_other_snk",
    outs = ["other.snk"],
    cmd = "$(execpath :keygen) $@",
    tools = [":keygen"],
)

csharp_library(
    name = "shared_dep_other_key",
    srcs = ["SharedDep.cs"],
    out = "SharedDep",
    keyfile = ":other.snk",
    target_frameworks = ["net48"],
    version = "2.0.0",
)

csharp_library(
    name = "shared_dep_v1",
    srcs = ["SharedDep.cs"],
    out = "SharedDep",
    keyfile = ":test.snk",
    # Satellites carry the library's version. v1 and v2 each have a culture
    # the other lacks.
    resources = [
        "Strings.de.resx",
        "Strings.es.resx",
        "Strings.resx",
    ],
    target_frameworks = ["net48"],
    version = "1.0.0",
)

csharp_library(
    name = "shared_dep_v2",
    srcs = ["SharedDep.cs"],
    out = "SharedDep",
    keyfile = ":test.snk",
    resources = [
        "Strings.de.resx",
        "Strings.fr.resx",
        "Strings.resx",
    ],
    target_frameworks = ["net48"],
    version = "2.0.0",
)

# Compiled against SharedDep 1.0.0.0 but run with 2.0.0.0, which needs a
# binding redirect.
csharp_library(
    name = "consumer_compiled",
    srcs = ["Consumer.cs"],
    out = "Consumer",
    generate_documentation_file = False,
    target_frameworks = ["net48"],
    deps = [":shared_dep_v1"],
)

import_library(
    name = "consumer",
    library_name = "Consumer",
    libs = [":consumer_compiled"],
    refs = [":consumer_compiled"],
    version = "1.0.0",
    deps = [":shared_dep_v2"],
)

csharp_library(
    name = "unsigned_dep",
    srcs = ["UnsignedDep.cs"],
    target_frameworks = ["net48"],
    version = "1.5.0",
)

csharp_binary(
    name = "app",
    srcs = ["Program.cs"],
    resources = ["resource.txt"],
    target_frameworks = ["net48"],
    deps = [
        ":consumer",
        ":unsigned_dep",
    ],
)

fsharp_binary(
    name = "fsharp_app",
    srcs = ["FSharpApp.fs"],
    target_frameworks = ["net48"],
    deps = [
        "@paket.rules_dotnet_dev_nuget_packages//fsharp.core",
    ],
)

# References SharedDep 2.0.0.0, newer than Consumer's 1.0.0.0.
csharp_library(
    name = "uses_v2",
    srcs = ["UsesV2.cs"],
    generate_documentation_file = False,
    target_frameworks = ["net48"],
    deps = [":shared_dep_v2"],
)

# Consumer brings SharedDep 1.0.0.0 and the binary 2.0.0.0: the highest ships,
# and Consumer's reference is redirected to it.
_CONFLICT_DEPS = [
    ":consumer_compiled",
    ":shared_dep_v2",
]

csharp_binary(
    name = "conflict_app",
    srcs = ["ConflictApp.cs"],
    target_frameworks = ["net48"],
    deps = _CONFLICT_DEPS,
)

csharp_test(
    name = "conflict_runtime_test",
    size = "small",
    srcs = ["ConflictApp.cs"],
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = _CONFLICT_DEPS,
)

# Generated redirects and <supportedRuntime> are merged into the user's App.config.
csharp_binary(
    name = "app_config_app",
    srcs = ["AppConfigApp.cs"],
    app_config = "App.config",
    target_frameworks = ["net48"],
    deps = [":consumer"],
)

csharp_test(
    name = "app_config_runtime_test",
    size = "small",
    srcs = ["AppConfigApp.cs"],
    app_config = "App.config",
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = [":consumer"],
)

publish_binary(
    name = "app_publish",
    binary = ":app",
    target_framework = "net48",
)

# All publish files: `$(rootpaths)` of the publish names only its executable.
filegroup(
    name = "app_publish_files",
    srcs = [":app_publish"],
)

csharp_nunit_test(
    name = "netfx_output_test",
    size = "small",
    srcs = ["NetFxOutputTests.cs"],
    data = [
        ":app",
        ":app_config_app",
        ":app_publish_files",
        ":conflict_app",
        ":conflict_publish_files",
        ":fsharp_app",
    ],
    envs = {
        "APP_CONFIG_APP_FILES": "$(rootpaths :app_config_app)",
        "CONFLICT_APP_FILES": "$(rootpaths :conflict_app)",
        "CONFLICT_PUBLISH_FILES": "$(rootpaths :conflict_publish_files)",
        "CSHARP_APP_FILES": "$(rootpaths :app)",
        "CSHARP_APP_LAUNCHER": "$(rootpath :app)",
        "FSHARP_APP_FILES": "$(rootpaths :fsharp_app)",
        "PUBLISH_FILES": "$(rootpaths :app_publish_files)",
    },
    nullable = "enable",
    target_frameworks = ["net8.0"],
)

# Publishes the conflict app's satellite directories.
publish_binary(
    name = "conflict_publish",
    binary = ":conflict_app",
    target_framework = "net48",
)

filegroup(
    name = "conflict_publish_files",
    srcs = [":conflict_publish"],
)

# Binding redirects follow the references of the executable and of the
# assemblies beside it, so netfx_config reads them...
netfx_config_inputs_test(
    name = "netfx_config_inputs_test",
    expected = [
        "Consumer.dll",
        "SharedDep.dll",
        "app.exe",
        "unsigned_dep.dll",
    ],
    target_under_test = ":app",
)

csharp_binary(
    name = "app_without_redirects",
    srcs = ["Program.cs"],
    auto_generate_binding_redirects = False,
    resources = ["resource.txt"],
    tags = ["manual"],
    target_frameworks = ["net48"],
    deps = [
        ":consumer",
        ":unsigned_dep",
    ],
)

# ...and without them, it does not.
netfx_config_inputs_test(
    name = "netfx_config_inputs_without_redirects_test",
    target_under_test = ":app_without_redirects",
    unexpected = [
        "Consumer.dll",
        "SharedDep.dll",
        "app_without_redirects.exe",
        "unsigned_dep.dll",
    ],
)

publish_runfiles_test(
    name = "publish_runfiles_test",
    expected = [
        "Consumer.dll",
        "SharedDep.dll",
        "app.exe",
        "app.exe.config",
        "unsigned_dep.dll",
    ],
    target_under_test = ":app_publish",
)

# Runs the tool's logic in process.
csharp_nunit_test(
    name = "netfx_config_test",
    size = "small",
    srcs = [
        "NetFxConfigTests.cs",
        "//dotnet/private/tools/netfx_config:srcs",
    ],
    data = [
        ":consumer_compiled",
        ":shared_dep_other_key",
        ":shared_dep_v1",
        ":shared_dep_v2",
        ":uses_v2",
    ],
    envs = {
        "CONSUMER_FILES": "$(rootpaths :consumer_compiled)",
        "SHARED_DEP_OTHER_KEY_FILES": "$(rootpaths :shared_dep_other_key)",
        "SHARED_DEP_V1_FILES": "$(rootpaths :shared_dep_v1)",
        "SHARED_DEP_V2_FILES": "$(rootpaths :shared_dep_v2)",
        "USES_V2_FILES": "$(rootpaths :uses_v2)",
    },
    nullable = "enable",
    target_frameworks = ["net10.0"],
)

csharp_test(
    name = "net48_runtime_test",
    size = "small",
    srcs = ["Program.cs"],
    resources = ["resource.txt"],
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = [
        ":consumer",
        ":unsigned_dep",
    ],
)
