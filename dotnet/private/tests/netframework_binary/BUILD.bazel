load(
    "//dotnet:defs.bzl",
    "csharp_binary",
    "csharp_library",
    "csharp_nunit_test",
    "csharp_test",
    "fsharp_binary",
    "import_library",
    "publish_binary",
)

csharp_binary(
    name = "keygen",
    srcs = ["KeyGen.cs"],
    nullable = "enable",
    target_frameworks = ["net8.0"],
)

genrule(
    name = "generate_snk",
    outs = ["test.snk"],
    cmd = "$(execpath :keygen) $@",
    tools = [":keygen"],
)

csharp_library(
    name = "shared_dep_v1",
    srcs = ["SharedDep.cs"],
    out = "SharedDep",
    keyfile = ":test.snk",
    target_frameworks = ["net48"],
    version = "1.0.0",
)

csharp_library(
    name = "shared_dep_v2",
    srcs = ["SharedDep.cs"],
    out = "SharedDep",
    keyfile = ":test.snk",
    target_frameworks = ["net48"],
    version = "2.0.0",
)

# Compiled against SharedDep 1.0.0.0, but paired at runtime with SharedDep 2.0.0.0
# so the .NET Framework CLR requires a <bindingRedirect> in <exe>.config.
csharp_library(
    name = "consumer_compiled",
    srcs = ["Consumer.cs"],
    out = "Consumer",
    generate_documentation_file = False,
    target_frameworks = ["net48"],
    deps = [":shared_dep_v1"],
)

import_library(
    name = "consumer",
    library_name = "Consumer",
    libs = [":consumer_compiled"],
    refs = [":consumer_compiled"],
    version = "1.0.0",
    deps = [":shared_dep_v2"],
)

csharp_library(
    name = "unsigned_dep",
    srcs = ["UnsignedDep.cs"],
    target_frameworks = ["net48"],
    version = "1.5.0",
)

csharp_binary(
    name = "app",
    srcs = ["Program.cs"],
    resources = ["resource.txt"],
    target_frameworks = ["net48"],
    deps = [
        ":consumer",
        ":unsigned_dep",
    ],
)

fsharp_binary(
    name = "fsharp_app",
    srcs = ["FSharpApp.fs"],
    target_frameworks = ["net48"],
    deps = [
        "@paket.rules_dotnet_dev_nuget_packages//fsharp.core",
    ],
)

# Compiled against SharedDep 2.0.0.0, for the netfx_config tests: a reference
# newer than the SharedDep 1.0.0.0 that Consumer brings.
csharp_library(
    name = "uses_v2",
    srcs = ["UsesV2.cs"],
    generate_documentation_file = False,
    target_frameworks = ["net48"],
    deps = [":shared_dep_v2"],
)

# Consumer brings SharedDep 1.0.0.0 and the binary SharedDep 2.0.0.0. As
# MSBuild's ResolveAssemblyReference does, the application ships the highest
# version, wherever each comes in the dependency graph, and redirects Consumer's
# reference to it.
_CONFLICT_DEPS = [
    ":consumer_compiled",
    ":shared_dep_v2",
]

csharp_binary(
    name = "conflict_app",
    srcs = ["ConflictApp.cs"],
    target_frameworks = ["net48"],
    deps = _CONFLICT_DEPS,
)

csharp_test(
    name = "conflict_runtime_test",
    size = "small",
    srcs = ["ConflictApp.cs"],
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = _CONFLICT_DEPS,
)

# The user's App.config, which the generated redirects and <supportedRuntime>
# are merged into.
csharp_binary(
    name = "app_config_app",
    srcs = ["AppConfigApp.cs"],
    app_config = "App.config",
    target_frameworks = ["net48"],
    deps = [":consumer"],
)

csharp_test(
    name = "app_config_runtime_test",
    size = "small",
    srcs = ["AppConfigApp.cs"],
    app_config = "App.config",
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = [":consumer"],
)

publish_binary(
    name = "app_publish",
    binary = ":app",
    target_framework = "net48",
)

# Every file of the publish: `$(rootpaths)` of the publish itself names only its
# executable.
filegroup(
    name = "app_publish_files",
    srcs = [":app_publish"],
)

csharp_nunit_test(
    name = "netfx_output_test",
    size = "small",
    srcs = ["NetFxOutputTests.cs"],
    data = [
        ":app",
        ":app_config_app",
        ":app_publish_files",
        ":conflict_app",
        ":fsharp_app",
    ],
    envs = {
        "APP_CONFIG_APP_FILES": "$(rootpaths :app_config_app)",
        "CONFLICT_APP_FILES": "$(rootpaths :conflict_app)",
        "CSHARP_APP_FILES": "$(rootpaths :app)",
        "CSHARP_APP_LAUNCHER": "$(rootpath :app)",
        "FSHARP_APP_FILES": "$(rootpaths :fsharp_app)",
        "PUBLISH_FILES": "$(rootpaths :app_publish_files)",
    },
    nullable = "enable",
    target_frameworks = ["net8.0"],
)

# Runs the tool's logic in process, on assemblies built here.
csharp_nunit_test(
    name = "netfx_config_test",
    size = "small",
    srcs = [
        "NetFxConfigTests.cs",
        "//dotnet/private/tools/netfx_config:srcs",
    ],
    data = [
        ":consumer_compiled",
        ":shared_dep_v1",
        ":shared_dep_v2",
        ":uses_v2",
    ],
    envs = {
        "CONSUMER_FILES": "$(rootpaths :consumer_compiled)",
        "SHARED_DEP_V1_FILES": "$(rootpaths :shared_dep_v1)",
        "SHARED_DEP_V2_FILES": "$(rootpaths :shared_dep_v2)",
        "USES_V2_FILES": "$(rootpaths :uses_v2)",
    },
    nullable = "enable",
    target_frameworks = ["net10.0"],
)

csharp_test(
    name = "net48_runtime_test",
    size = "small",
    srcs = ["Program.cs"],
    resources = ["resource.txt"],
    target_compatible_with = ["@platforms//os:windows"],
    target_frameworks = ["net48"],
    deps = [
        ":consumer",
        ":unsigned_dep",
    ],
)
