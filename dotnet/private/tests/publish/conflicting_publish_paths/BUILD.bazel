load("//dotnet:defs.bzl", "csharp_binary", "csharp_library", "dotnet_content_files", "import_library", "nuget_pack", "publish_binary")
load("//dotnet/private/tests/nuget_pack:nuget_pack_test.bzl", "fails_with_test")
load(":tests.bzl", "one_file_per_path_test", "publish_conflict_test", "publish_succeeds_test")

# `lib_one` and `lib_two` both build `lib.dll`, and `a` and `b` each see only
# one of them. Nothing conflicts until a publish flattens the whole closure
# into a single directory.
csharp_library(
    name = "lib_one",
    srcs = ["One.cs"],
    out = "lib",
    target_frameworks = ["net10.0"],
)

csharp_library(
    name = "lib_two",
    srcs = ["Two.cs"],
    out = "lib",
    target_frameworks = ["net10.0"],
)

csharp_library(
    name = "a",
    srcs = ["A.cs"],
    target_frameworks = ["net10.0"],
    deps = [":lib_one"],
)

csharp_library(
    name = "b",
    srcs = ["B.cs"],
    target_frameworks = ["net10.0"],
    deps = [":lib_two"],
)

csharp_binary(
    name = "app",
    srcs = ["Main.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        ":a",
        ":b",
    ],
)

publish_binary(
    name = "duplicate_assembly_names",
    binary = ":app",
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_conflict_test(
    name = "duplicate_assembly_names_test",
    size = "small",
    expected_message_fragments = [
        ":lib_one and ",
        ":lib_two are both published as \"lib.dll\".",
    ],
    target_under_test = ":duplicate_assembly_names",
)

# Self-contained, so the runtime pack assemblies are checked too, and
# ReadyToRun, so the check has to run before crossgen2 declares its outputs.
publish_binary(
    name = "duplicate_assembly_names_ready_to_run",
    binary = ":app",
    ready_to_run = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_conflict_test(
    name = "duplicate_assembly_names_ready_to_run_test",
    size = "small",
    expected_message_fragments = [
        ":lib_one and ",
        ":lib_two are both published as \"lib.dll\".",
    ],
    target_under_test = ":duplicate_assembly_names_ready_to_run",
)

# Placeholder files, never built or loaded: only their `runtimes/<rid>/native/`
# paths matter, which is where a NuGet package keeps its native assets. A
# package built by the rules only ever offers the target RID's natives, so
# reaching this needs an `import_library` written by hand.
import_library(
    name = "native_glibc",
    library_name = "NativeGlibc",
    native = ["glibc/runtimes/linux-x64/native/libnative.so"],
    version = "1.0.0",
)

import_library(
    name = "native_musl",
    library_name = "NativeMusl",
    native = ["musl/runtimes/linux-musl-x64/native/libnative.so"],
    version = "1.0.0",
)

csharp_binary(
    name = "native_app",
    srcs = ["NativeMain.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        ":native_glibc",
        ":native_musl",
    ],
)

# A self-contained publish carries native libraries next to the main DLL, where
# the RID in their path no longer keeps them apart. Both come from a package, so
# one of them is published and neither target is blamed for it.
publish_binary(
    name = "duplicate_native_names",
    binary = ":native_app",
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_succeeds_test(
    name = "duplicate_native_names_test",
    size = "small",
    target_under_test = ":duplicate_native_names",
)

# The same goes for the natives a single-file or NativeAOT executable keeps
# beside it: one of them is copied there, not both into the same path.
publish_binary(
    name = "duplicate_native_names_single_file",
    binary = ":native_app",
    self_contained = True,
    single_file = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

one_file_per_path_test(
    name = "duplicate_native_names_single_file_test",
    size = "small",
    basename = "libnative.so",
    mnemonic = "DotnetCopySidecars",
    target_under_test = ":duplicate_native_names_single_file",
)

publish_binary(
    name = "duplicate_native_names_native_aot",
    binary = ":native_app",
    native_aot = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

one_file_per_path_test(
    name = "duplicate_native_names_native_aot_test",
    size = "small",
    basename = "libnative.so",
    mnemonic = "DotnetCopySidecars",
    target_under_test = ":duplicate_native_names_native_aot",
)

# A framework-dependent publish puts them beside the main DLL too: they name no
# NuGet package, so the deps.json lists them as `native` assets, which the host
# looks for there. As above, one of them is published.
publish_binary(
    name = "duplicate_native_names_framework_dependent",
    binary = ":native_app",
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_succeeds_test(
    name = "duplicate_native_names_framework_dependent_test",
    size = "small",
    target_under_test = ":duplicate_native_names_framework_dependent",
)

# Two packages that ship the same assembly file name, which is what a package
# repackaged under a second id looks like. The compile actions resolve the
# duplicate identity by order, and the publish has to agree with them.
import_library(
    name = "packaged_one",
    library_name = "PackagedOne",
    libs = ["pkg_one/lib/net10.0/Shared.dll"],
    version = "1.0.0",
)

import_library(
    name = "packaged_two",
    library_name = "PackagedTwo",
    libs = ["pkg_two/lib/net10.0/Shared.dll"],
    version = "1.0.0",
)

csharp_binary(
    name = "packaged_app",
    srcs = ["NativeMain.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        ":packaged_one",
        ":packaged_two",
    ],
)

publish_binary(
    name = "duplicate_packaged_assemblies",
    binary = ":packaged_app",
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_succeeds_test(
    name = "duplicate_packaged_assemblies_test",
    size = "small",
    target_under_test = ":duplicate_packaged_assemblies",
)

# A composite image compiles the assembly that is published, not both.
publish_binary(
    name = "duplicate_packaged_assemblies_composite",
    binary = ":packaged_app",
    ready_to_run = True,
    ready_to_run_composite = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

one_file_per_path_test(
    name = "duplicate_packaged_assemblies_composite_test",
    size = "small",
    basename = "Shared.dll",
    mnemonic = "Crossgen2Composite",
    target_under_test = ":duplicate_packaged_assemblies_composite",
)

# A content file's path was chosen, so a package's assembly there is a mistake
# rather than a duplicate to resolve by order: the content file would silently
# take the assembly's place, even after a composite image was compiled from the
# assembly.
dotnet_content_files(
    name = "shared_dll_content",
    srcs = ["pkg_two/lib/net10.0/Shared.dll"],
    strip_prefix = "pkg_two/lib/net10.0",
)

csharp_library(
    name = "with_shared_dll_content",
    srcs = ["Two.cs"],
    content_files = [":shared_dll_content"],
    target_frameworks = ["net10.0"],
)

csharp_binary(
    name = "content_over_package_app",
    srcs = ["NativeMain.cs"],
    target_frameworks = ["net10.0"],
    deps = [
        ":packaged_one",
        ":with_shared_dll_content",
    ],
)

publish_binary(
    name = "content_over_package_assembly",
    binary = ":content_over_package_app",
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_conflict_test(
    name = "content_over_package_assembly_test",
    size = "small",
    expected_message_fragments = [
        "the content file dotnet/private/tests/publish/conflicting_publish_paths/pkg_two/lib/net10.0/Shared.dll of ",
        ":with_shared_dll_content would be published as \"Shared.dll\", but so would ",
        "pkg_one/lib/net10.0/Shared.dll.",
    ],
    target_under_test = ":content_over_package_assembly",
)

publish_binary(
    name = "content_over_package_assembly_composite",
    binary = ":content_over_package_app",
    ready_to_run = True,
    ready_to_run_composite = True,
    self_contained = True,
    tags = ["manual"],
    target_framework = "net10.0",
)

publish_conflict_test(
    name = "content_over_package_assembly_composite_test",
    size = "small",
    expected_message_fragments = [
        ":with_shared_dll_content would be published as \"Shared.dll\", but so would ",
        "pkg_one/lib/net10.0/Shared.dll.",
    ],
    target_under_test = ":content_over_package_assembly_composite",
)

# A tool package ships the binary's publish, so the same clash fails packing.
nuget_pack(
    name = "content_over_package_assembly_tool",
    authors = ["rules_dotnet"],
    binary = ":content_over_package_app",
    description = "d",
    tags = ["manual"],
    target_frameworks = ["net10.0"],
)

fails_with_test(
    name = "content_over_package_assembly_tool_test",
    size = "small",
    expected_message_fragments = [
        ":with_shared_dll_content would be packed as \"tools/net10.0/any/Shared.dll\", but so would ",
        "pkg_one/lib/net10.0/Shared.dll.",
    ],
    target_under_test = ":content_over_package_assembly_tool",
)
