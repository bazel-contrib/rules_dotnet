load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//dotnet:defs.bzl",
    "csharp_binary",
    "csharp_library",
    "publish_binary",
)

# A library nothing refers to in code, as if the application only reached it
# through reflection. The trimmer has no reference to keep it by, so only the
# SDK's partial trimming, which leaves alone assemblies that do not declare
# themselves trimmable, ships it.
csharp_library(
    name = "reflected",
    srcs = ["Reflected.cs"],
    target_frameworks = ["net10.0"],
)

csharp_binary(
    name = "app",
    srcs = [
        "App.razor",
        "Program.cs",
        "_Imports.razor",
    ],
    project_sdk = "blazorwasm",
    root_namespace = "BlazorApp",
    static_web_assets = glob(["wwwroot/**"]),
    target_frameworks = ["net10.0"],
    deps = [
        ":reflected",
        "@paket.rules_dotnet_static_web_assets_tests//microsoft.aspnetcore.components.webassembly",
    ],
)

publish_binary(
    name = "publish",
    binary = ":app",
    target_framework = "net10.0",
    wasm = True,
)

sh_test(
    name = "publish_test",
    srcs = ["test.sh"],
    data = [":publish"],
)
