def _failure_test_impl(ctx):
    env = analysistest.begin(ctx)
    asserts.expect_failure(env, ctx.attr.expected_message)
    return analysistest.end(env)

_failure_test = analysistest.make(
    _failure_test_impl,
    expect_failure = True,
    attrs = {
        "expected_message": attr.string(mandatory = True),
    },
)

def _compile_action(target):
    compiles = [a for a in target.actions if a.mnemonic == "CSharpCompile"]
    if len(compiles) != 1:
        fail("Expected one CSharpCompile action in {}, found {}".format(target.label, len(compiles)))
    return compiles[0]

def _global_usings_write_actions(target):
    return [
        a
        for a in target.actions
        if a.mnemonic == "FileWrite" and any([o.basename.endswith(".GlobalUsings.g.cs") for o in a.outputs.to_list()])
    ]

def _expected_content(namespaces):
    return "\n".join(["// <auto-generated/>"] + ["global using %s;" % ns for ns in namespaces] + [""])

def _expect_global_usings(env, target, namespaces):
    writes = _global_usings_write_actions(target)
    compile_argv = _compile_action(target).argv

    if not namespaces:
        env.expect.that_collection(writes).has_size(0)
        env.expect.that_collection([arg for arg in compile_argv if ".GlobalUsings.g.cs" in arg]).has_size(0)
        return

    env.expect.that_collection(writes).has_size(1)
    write = writes[0]
    output = write.outputs.to_list()[0]
    env.expect.that_str(write.content).equals(_expected_content(namespaces))
    env.expect.that_collection([arg for arg in compile_argv if output.short_path in arg]).has_size(1)

