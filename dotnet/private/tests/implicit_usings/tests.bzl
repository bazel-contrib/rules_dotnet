# buildifier: disable=unnamed-macro
def implicit_usings_test_suite(name):
    """Defines analysis and execution tests for C# implicit and global usings.

    Args:
        name: Name of the analysis test suite.
    """
    test_suite(
        name = name,
        tests = [
            _disabled_by_default_test,
            _default_sdk_test,
            _netframework_omits_http_test,
            _razor_sdk_test,
            _blazorwasm_sdk_test,
            _web_sdk_test,
            _winforms_framework_ref_test,
            _windowsdesktop_framework_ref_test,
            _wpf_only_framework_ref_test,
            _wpf_explicit_global_using_restores_system_io_test,
            _explicit_global_usings_only_test,
            _include_and_exclude_test,
            _all_excluded_writes_no_file_test,
        ],
    )

    csharp_library(
        name = "langversion_below_10_lib",
        srcs = _SRCS,
        implicit_usings = True,
        tags = ["manual"],
        target_frameworks = ["net48"],
    )
    _failure_test(
        name = "langversion_below_10_fails_test",
        expected_message = "`implicit_usings` and `global_usings` require C# 10 or later, but net48 compiles with C# 7.3.",
        target_under_test = ":langversion_below_10_lib",
    )

    csharp_library(
        name = "invalid_global_using_lib",
        srcs = _SRCS,
        global_usings = ["System.IO;"],
        tags = ["manual"],
        target_frameworks = ["net10.0"],
    )
    _failure_test(
        name = "invalid_global_using_fails_test",
        expected_message = "invalid namespace \"System.IO;\" in `global_usings`",
        target_under_test = ":invalid_global_using_lib",
    )

    csharp_library(
        name = "default_sdk_lib",
        srcs = ["DefaultSdkLibrary.cs"],
        enforce_code_style_in_build = "true",
        excluded_global_usings = ["System.Net.Http"],
        global_usings = [
            "CustomHttp",
            "System.Text.Json",
        ],
        implicit_usings = True,
        internals_visible_to = ["ImplicitUsingsTest"],
        nullable = "enable",
        target_frameworks = ["net10.0"],
        treat_warnings_as_errors = True,
    )

    csharp_library(
        name = "web_sdk_lib",
        srcs = ["WebSdkLibrary.cs"],
        implicit_usings = True,
        nullable = "enable",
        project_sdk = "web",
        target_frameworks = ["net10.0"],
        treat_warnings_as_errors = True,
    )

    csharp_library(
        name = "net48_lib",
        srcs = ["Net48Library.cs"],
        implicit_usings = True,
        langversion = "10.0",
        target_frameworks = ["net48"],
        treat_warnings_as_errors = True,
    )

    csharp_binary(
        name = "implicit_usings_bin",
        srcs = ["Program.cs"],
        implicit_usings = True,
        target_frameworks = ["net10.0"],
        treat_warnings_as_errors = True,
    )

    csharp_test(
        name = "implicit_usings_csharp_test",
        srcs = ["Program.cs"],
        implicit_usings = True,
        target_frameworks = ["net10.0"],
        treat_warnings_as_errors = True,
    )

    csharp_nunit_test(
        name = "ImplicitUsingsTest",
        srcs = ["ImplicitUsingsTest.cs"],
        global_usings = [
            "ImplicitUsingsLib",
            "NUnit.Framework",
        ],
        implicit_usings = True,
        nullable = "enable",
        target_frameworks = ["net10.0"],
        deps = [":default_sdk_lib"],
    )
