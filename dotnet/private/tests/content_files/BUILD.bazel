load("//dotnet:defs.bzl", "csharp_library", "csharp_nunit_test", "dotnet_content_files")
load(":tests.bzl", "content_files_test_suite")

# Analysis tests: assert that content_files preserve their package-relative
# directory structure in the target's default outputs.
content_files_test_suite(name = "content_files_test_suite")

# End-to-end runtime test: build a real test binary with nested content_files and
# assert at runtime that they were copied next to the assembly with their directory
# structure intact (resolvable relative to AppContext.BaseDirectory).
csharp_nunit_test(
    name = "content_files_runtime_test",
    srcs = ["ContentFilesTest.cs"],
    content_files = [
        "content/settings.json",
        "content/nested/data.txt",
    ],
    target_frameworks = ["net6.0"],
)

# End-to-end runtime test for dotnet_content_files: the rule strips the `content/` prefix
# and re-roots the tree under `config/`; assert at runtime that the remapped files are
# copied next to the assembly at the new paths.
dotnet_content_files(
    name = "runtime_remapped_content",
    srcs = [
        "content/nested/data.txt",
        "content/settings.json",
    ],
    prefix = "config",
    strip_prefix = "content",
)

csharp_nunit_test(
    name = "content_files_rule_runtime_test",
    srcs = ["ContentFilesRuleTest.cs"],
    content_files = [":runtime_remapped_content"],
    target_frameworks = ["net6.0"],
)

# End-to-end runtime test for a library's content_files: the test lists none itself, so the
# files it finds next to its assembly are the ones the library it depends on brought along.
csharp_library(
    name = "library_with_content",
    srcs = ["Main.cs"],
    content_files = [
        "content/settings.json",
        "content/nested/data.txt",
    ],
    target_frameworks = ["net6.0"],
)

csharp_nunit_test(
    name = "content_files_library_runtime_test",
    srcs = ["ContentFilesTest.cs"],
    target_frameworks = ["net6.0"],
    deps = [":library_with_content"],
)

# End-to-end runtime test for overriding a library's content file: the library ships
# `conflict/settings.json` at `content/settings.json`, the test lists its own
# `content/settings.json`, and the test's file is the one next to its assembly.
dotnet_content_files(
    name = "library_default_settings",
    srcs = ["conflict/settings.json"],
    prefix = "content",
    strip_prefix = "conflict",
)

csharp_library(
    name = "library_with_default_settings",
    srcs = ["Main.cs"],
    out = "library_with_default_settings_dll",
    content_files = [":library_default_settings"],
    target_frameworks = ["net6.0"],
)

csharp_nunit_test(
    name = "content_files_override_runtime_test",
    srcs = ["ContentFilesOverrideTest.cs"],
    content_files = ["content/settings.json"],
    target_frameworks = ["net6.0"],
    deps = [":library_with_default_settings"],
)
