load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_setting")

# Set on the edges from a .NET target to its dependencies, so that each picks
# the framework its consumer can use. See tfm_transition.bzl.
bool_setting(
    name = "framework_from_consumer",
    build_setting_default = False,
    scope = "target",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "common",
    srcs = ["common.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        "//dotnet/private:common",
        "//dotnet/private:portable_rids",
        "@bazel_skylib//lib:sets",
        "@platforms//host:constraints_lib",
    ],
)

bzl_library(
    name = "wasm_pack_transition",
    srcs = ["wasm_pack_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:common",
        "//dotnet/private:portable_rids",
        "//dotnet/private/sdk:packs",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "tfm_transition",
    srcs = ["tfm_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:common",
        "//dotnet/private:portable_rids",
        "//dotnet/private/sdk:packs",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "native_transition",
    srcs = ["native_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:common",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "default_transition",
    srcs = ["default_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:common",
        "//dotnet/private:portable_rids",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "bootstrap_tool_transition",
    srcs = ["bootstrap_tool_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        "//dotnet/private:portable_rids",
        "@bazel_skylib//lib:dicts",
    ],
)

bzl_library(
    name = "icu_transition",
    srcs = ["icu_transition.bzl"],
    visibility = ["//dotnet:__subpackages__"],
    deps = [
        ":common",
        ":default_transition",
        "@bazel_skylib//lib:dicts",
    ],
)
