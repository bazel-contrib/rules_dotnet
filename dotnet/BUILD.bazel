load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//dotnet/private:resolved_toolchain.bzl", "resolved_toolchain", "resolved_toolchain_assembly")
load(
    "//dotnet/private/macros:register_rids.bzl",
    "register_rids",
)
load(
    "//dotnet/private/macros:register_tfms.bzl",
    "register_tfms",
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

resolved_toolchain(
    name = "resolved_toolchain",
    # Marked manual so that `bazel test //...` passes
    # even if no toolchain is registered.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

resolved_toolchain_assembly(
    name = "aspnetcore_razor_toolset",
    assembly = "aspnetcore_razor_toolset",
    visibility = ["//tools/razor:__pkg__"],
)

register_tfms()

register_rids()

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dotnet/private/rules/blazor:component",
        "//dotnet/private/rules/blazor:library",
        "//dotnet/private/rules/blazor:publish",
        "//dotnet/private/rules/csharp:binary",
        "//dotnet/private/rules/csharp:library",
        "//dotnet/private/rules/csharp:nunit_test",
        "//dotnet/private/rules/csharp:test",
        "//dotnet/private/rules/fsharp:binary",
        "//dotnet/private/rules/fsharp:library",
        "//dotnet/private/rules/fsharp:nunit_test",
        "//dotnet/private/rules/fsharp:test",
        "//dotnet/private/rules/nuget:dotnet_tool",
        "//dotnet/private/rules/nuget:imports",
        "//dotnet/private/rules/nuget:nuget_archive",
        "//dotnet/private/rules/nuget:nuget_repo",
        "//dotnet/private/rules/publish_binary",
        "//dotnet/private/rules/resources:resx_resource",
    ],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dotnet/private:toolchains_repo",
        "//dotnet/private/sdk:versions",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "host",
    srcs = ["host.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dotnet/private:toolchains_repo"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":host",
        ":repositories",
        "//dotnet/private/sdk:pack_repos",
    ],
)

bzl_library(
    name = "paket",
    srcs = ["paket.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dotnet/private/paket:extension"],
)

exports_files(["defs.bzl"])

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//dotnet/private:providers",
    ],
)

bzl_library(
    name = "internal_dev_deps",
    srcs = ["internal_dev_deps.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@bazel_ci_rules//:rbe_repo"],
)
