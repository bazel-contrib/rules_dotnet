"rules_dotnet examples"

module(
    name = "rules_dotnet_examples",
    version = "0.0.0",
    compatibility_level = 1,
)

# Only needed to make the Bazel CI RBE config work. Not needed for using rules_dotnet.
bazel_dep(name = "bazel_ci_rules", version = "1.0.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "0.0.10", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.19", dev_dependency = True)

internal_dev_deps = use_extension("//:internal_dev_deps.bzl", "internal_dev_deps", dev_dependency = True)
use_repo(internal_dev_deps, "buildkite_config")

bazel_dep(name = "rules_dotnet", version = "0.0.0")
local_path_override(
    module_name = "rules_dotnet",
    path = "..",
)

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.401")
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

paket = use_extension("@rules_dotnet//dotnet:paket.bzl", "paket")
paket.parse(
    dependencies = "//:paket.dependencies",
    groups = [
        "blazor_deps",
        "bolero_deps",
        "example_deps",
    ],
    lock = "//:paket.lock",
)
use_repo(paket, "paket.blazor_deps", "paket.bolero_deps", "paket.example_deps")

# A second lock file, showing that a package group is addressed by its name.
paket_example = use_extension("@rules_dotnet//dotnet:paket.bzl", "paket")
paket_example.parse(
    dependencies = "//paket:paket.dependencies",
    lock = "//paket:paket.lock",
)
use_repo(paket_example, "paket.main", "paket.othergroup")

# nuget.resolve for //nuget_resolve: transitive resolution with a checked-in
# nuget_resolve.json. The tag is named after the example; the gazelle_csharp
# example below uses its own tag named "nuget".
nuget = use_extension("@rules_dotnet//dotnet:nuget.bzl", "nuget")
nuget.resolve(
    name = "nuget_resolve",
    packages = {
        "Serilog": "4.0.0",
        "Serilog.Sinks.Console": "6.0.0",
    },
    frameworks = ["net10.0"],
    lock_file = "//nuget_resolve:nuget_resolve.json",
)
use_repo(nuget, "nuget_resolve.net10.0")

# Gazelle for //gazelle_csharp, demonstrating the C# Gazelle extension.
# rules_go and the Go SDK come transitively from rules_dotnet.
bazel_dep(name = "gazelle", version = "0.51.3", repo_name = "bazel_gazelle")

# rules_go is needed as a direct dependency so that the Go SDK is registered
# for the gazelle_binary target above.
bazel_dep(name = "rules_go", version = "0.59.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

# gazelle_csharp resolves its NuGet dependency with nuget.resolve; the Gazelle
# extension indexes the same nuget_resolve.json to map namespaces to packages.
nuget.resolve(
    name = "nuget",
    packages = {
        "Newtonsoft.Json": "13.0.3",
    },
    frameworks = ["net10.0"],
    lock_file = "//gazelle_csharp:nuget_resolve.json",
)
use_repo(nuget, "nuget.net10.0")

# Builds the container images in //container_image.
bazel_dep(name = "rules_img", version = "0.3.22")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

# What a self-contained publish needs from the OS: the native libraries the
# runtime links against. A framework-dependent one needs the runtime too, from
# `dotnet/runtime` or `dotnet/aspnet`.
pull(
    name = "dotnet_runtime_deps",
    digest = "sha256:099f6f87ed745377dd27bd722f0d1a352bca71b4fddaabfd75e7c064bcaa82da",
    platforms = ["linux/amd64"],
    registry = "mcr.microsoft.com",
    repository = "dotnet/runtime-deps",
    tag = "10.0",
)
